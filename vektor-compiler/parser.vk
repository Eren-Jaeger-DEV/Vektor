import "tokens.vk";
import "ast.vk";

// ── Precedence Levels ────────────────────────────────────────
const PREC_NONE: i32 = 0;
const PREC_ASSIGNMENT: i32 = 1;
const PREC_OR: i32 = 2;
const PREC_AND: i32 = 3;
const PREC_EQUALITY: i32 = 4;
const PREC_COMPARISON: i32 = 5;
const PREC_TERM: i32 = 6;
const PREC_FACTOR: i32 = 7;
const PREC_UNARY: i32 = 8;
const PREC_CALL: i32 = 9;
const PREC_POSTFIX: i32 = 10;

struct Parser {
  current: Token;
  previous: Token;
  has_error: bool;
  panic_mode: bool;
  error_msg: str;
  error_line: i32;
  error_col: i32;
  ast: ASTNode;
}

function parser_new(tokens: Token) -> Parser {
  return Parser {
    current: tokens,
    previous: null,
    has_error: false,
    panic_mode: false,
    error_msg: "",
    error_line: 0,
    error_col: 0,
    ast: null
  };
}

function parser_is_at_end(p: Parser) -> bool {
  if (p.current == null) { return true; }
  return p.current.type == TOKEN_EOF;
}

function parser_peek(p: Parser) -> Token {
  return p.current;
}

function parser_previous(p: Parser) -> Token {
  return p.previous;
}

function parser_advance(p: Parser) -> Token {
  if (not parser_is_at_end(p)) {
    p.previous = p.current;
    p.current = p.current.next;
  }
  return parser_previous(p);
}

function parser_check(p: Parser, type: str) -> bool {
  if (parser_is_at_end(p)) { return false; }
  return parser_peek(p).type == type;
}

function parser_match_token(p: Parser, type: str) -> bool {
  if (parser_check(p, type)) {
    parser_advance(p);
    return true;
  }
  return false;
}

function parser_error_at(p: Parser, token: Token, message: str) {
  if (p.panic_mode) { return; }
  p.panic_mode = true;
  print("Parse Error at line " + toString(token.line) + " col " + toString(token.column) + " : " + message);
  p.has_error = true;
}

function parser_consume(p: Parser, type: str, message: str) -> Token {
  if (parser_check(p, type)) {
    return parser_advance(p);
  }
  parser_error_at(p, parser_peek(p), message);
  return Token { type: TOKEN_UNKNOWN, lexeme: "", line: 0, column: 0, num_val: 0.0, next: null };
}

// ── Expressions ──────────────────────────────────────────────

function get_precedence(type: str) -> i32 {
  if (type == TOKEN_EQUALS) { return PREC_ASSIGNMENT; }
  if (type == TOKEN_OR_OR or type == TOKEN_OR) { return PREC_OR; }
  if (type == TOKEN_AND_AND or type == TOKEN_AND) { return PREC_AND; }
  if (type == TOKEN_DOUBLE_EQUALS or type == TOKEN_NOT_EQUALS) { return PREC_EQUALITY; }
  if (type == TOKEN_LESS or type == TOKEN_GREATER or type == TOKEN_LESS_EQUALS or type == TOKEN_GREATER_EQUALS) { return PREC_COMPARISON; }
  if (type == TOKEN_PLUS or type == TOKEN_MINUS) { return PREC_TERM; }
  if (type == TOKEN_STAR or type == TOKEN_SLASH or type == TOKEN_PERCENT) { return PREC_FACTOR; }
  if (type == TOKEN_LPAREN or type == TOKEN_DOT or type == TOKEN_LBRACKET) { return PREC_POSTFIX; }
  if (type == TOKEN_PLUS_PLUS or type == TOKEN_MINUS_MINUS) { return PREC_POSTFIX; }
  return PREC_NONE;
}

function parse_expression(p: Parser, min_precedence: i32) -> ASTNode {
  let left: ASTNode = parse_prefix(p);

  let parsing: bool = true;
  while (parsing) {
    let token: Token = parser_peek(p);
    let precedence: i32 = get_precedence(token.type);

    if (precedence < min_precedence) {
      parsing = false;
    } else {
      let next_min_precedence: i32 = precedence + 1;
      if (precedence == PREC_ASSIGNMENT) {
        next_min_precedence = precedence;
      }

      parser_advance(p);
      left = parse_infix(p, left, token, next_min_precedence);
    }
  }

  return left;
}

function parse_prefix(p: Parser) -> ASTNode {
  let token: Token = parser_advance(p);
  let type: str = token.type;

  if (type == TOKEN_INTEGER_LITERAL) {
    let node: ASTNode = ast_node_new("IntegerLiteral", token.line, token.column);
    node.int_val = parseI32(token.lexeme);
    return node;
  }
  if (type == TOKEN_FLOAT_LITERAL) {
    let node: ASTNode = ast_node_new("FloatLiteral", token.line, token.column);
    node.float_val = parseFloat(token.lexeme);
    return node;
  }
  if (type == TOKEN_STRING_LITERAL) {
    let node: ASTNode = ast_node_new("StringLiteral", token.line, token.column);
    node.str_val = token.lexeme;
    return node;
  }
  if (type == TOKEN_CHAR_LITERAL) {
    let node: ASTNode = ast_node_new("CharLiteral", token.line, token.column);
    node.str_val = token.lexeme;
    return node;
  }
  if (type == TOKEN_TRUE or type == TOKEN_FALSE) {
    let node: ASTNode = ast_node_new("BooleanLiteral", token.line, token.column);
    node.bool_val = (type == TOKEN_TRUE);
    return node;
  }
  if (type == TOKEN_NULL) {
    return ast_node_new("NullLiteral", token.line, token.column);
  }
  if (type == TOKEN_IDENTIFIER) {
    let node: ASTNode = ast_node_new("Identifier", token.line, token.column);
    node.name = token.lexeme;
    
    // We only try to parse type args for identifiers if it looks like a generic call or struct literal
    let saved_current: Token = p.current;
    let saved_previous: Token = p.previous;
    
    // Check if it's a struct literal: Identifier { or Identifier < T > {
    // Or a generic function call: Identifier < T > (
    let has_type_args: bool = false;
    if (is_type_args(p)) {
      node.typeArgs = try_parse_type_args(p);
      has_type_args = true;
    }

    if (parser_check(p, TOKEN_LBRACE)) {
      let char1: str = charAt(token.lexeme, 0);
      if (char1 >= "A" and char1 <= "Z") {
        return parse_struct_literal(p, node);
      }
    }
    
    return node;
  }
  if (type == TOKEN_LPAREN) {
    let expr: ASTNode = parse_expression(p, PREC_ASSIGNMENT);
    parser_consume(p, TOKEN_RPAREN, "Expected ')' after expression.");
    return expr;
  }
  if (type == TOKEN_LBRACKET) {
    let node: ASTNode = ast_node_new("ArrayLiteral", token.line, token.column);
    let elements_head: ASTNode = null;
    let elements_tail: ASTNode = null;

    if (not parser_check(p, TOKEN_RBRACKET)) {
      let first: bool = true;
      while (first or parser_match_token(p, TOKEN_COMMA)) {
        first = false;
        let elem: ASTNode = parse_expression(p, PREC_ASSIGNMENT);
        if (elements_head == null) {
          elements_head = elem;
          elements_tail = elem;
        } else {
          elements_tail.next = elem;
          elements_tail = elem;
        }
      }
    }
    parser_consume(p, TOKEN_RBRACKET, "Expected ']' after array elements.");
    node.args = elements_head;
    return node;
  }
  if (type == TOKEN_MINUS or type == TOKEN_BANG or type == TOKEN_NOT or type == TOKEN_STAR or type == TOKEN_AND) {
    let node: ASTNode = ast_node_new("UnaryExpr", token.line, token.column);
    node.op = token.lexeme;
    node.right = parse_expression(p, PREC_UNARY);
    return node;
  }
  if (type == TOKEN_CAST) {
    parser_consume(p, TOKEN_LESS, "Expected '<' after cast.");
    let targetType: ASTNode = parse_type(p);
    parser_consume(p, TOKEN_GREATER, "Expected '>' after cast type.");
    parser_consume(p, TOKEN_LPAREN, "Expected '(' after cast type.");
    let castExpr: ASTNode = parse_expression(p, PREC_ASSIGNMENT);
    parser_consume(p, TOKEN_RPAREN, "Expected ')' after cast expression.");
    
    let node: ASTNode = ast_node_new("CastExpr", token.line, token.column);
    node.returnType = targetType;
    node.left = castExpr;
    return node;
  }
  if (type == TOKEN_ALLOC) {
    parser_consume(p, TOKEN_LPAREN, "Expected '(' after alloc.");
    let sizeExpr: ASTNode = parse_expression(p, PREC_ASSIGNMENT);
    parser_consume(p, TOKEN_RPAREN, "Expected ')' after alloc size.");
    let node: ASTNode = ast_node_new("AllocExpr", token.line, token.column);
    node.left = sizeExpr;
    return node;
  }
  if (type == TOKEN_FREE) {
    parser_consume(p, TOKEN_LPAREN, "Expected '(' after free.");
    let freeExpr: ASTNode = parse_expression(p, PREC_ASSIGNMENT);
    parser_consume(p, TOKEN_RPAREN, "Expected ')' after free expr.");
    
    let callee: ASTNode = ast_node_new("Identifier", token.line, token.column);
    callee.name = token.lexeme;
    
    let node: ASTNode = ast_node_new("CallExpr", token.line, token.column);
    node.callee = callee;
    node.args = freeExpr;
    return node;
  }
  if (type == TOKEN_CLONE) {
    parser_consume(p, TOKEN_LPAREN, "Expected '(' after clone.");
    let cloneExpr: ASTNode = parse_expression(p, PREC_ASSIGNMENT);
    parser_consume(p, TOKEN_RPAREN, "Expected ')' after clone expr.");
    let node: ASTNode = ast_node_new("CloneExpr", token.line, token.column);
    node.left = cloneExpr;
    return node;
  }
  if (type == TOKEN_OK or type == TOKEN_ERR) {
    parser_consume(p, TOKEN_LPAREN, "Expected '(' after Result constructor.");
    let resExpr: ASTNode = parse_expression(p, PREC_ASSIGNMENT);
    parser_consume(p, TOKEN_RPAREN, "Expected ')' after Result constructor.");
    
    let callee: ASTNode = ast_node_new("Identifier", token.line, token.column);
    callee.name = token.lexeme;
    
    let node: ASTNode = ast_node_new("CallExpr", token.line, token.column);
    node.callee = callee;
    node.args = resExpr;
    return node;
  }
  if (type == TOKEN_SPAWN) {
    let node: ASTNode = ast_node_new("SpawnExpr", token.line, token.column);
    node.left = parse_expression(p, PREC_ASSIGNMENT);
    return node;
  }

  print("Unexpected token in expression:", token.lexeme);
  p.has_error = true;
  return ast_node_new("Unknown", token.line, token.column);
}

function parse_infix(p: Parser, left: ASTNode, operator: Token, min_precedence: i32) -> ASTNode {
  let type: str = operator.type;

  if (type == TOKEN_PLUS or type == TOKEN_MINUS or type == TOKEN_STAR or type == TOKEN_SLASH or
      type == TOKEN_PERCENT or type == TOKEN_DOUBLE_EQUALS or type == TOKEN_NOT_EQUALS or
      type == TOKEN_LESS or type == TOKEN_GREATER or type == TOKEN_LESS_EQUALS or
      type == TOKEN_GREATER_EQUALS or type == TOKEN_AND_AND or type == TOKEN_AND or
      type == TOKEN_OR_OR or type == TOKEN_OR) {
    let right: ASTNode = parse_expression(p, min_precedence);
    let node: ASTNode = ast_node_new("BinaryExpr", left.line, left.column);
    node.left = left;
    node.right = right;
    node.op = operator.lexeme;
    return node;
  }
  if (type == TOKEN_EQUALS) {
    let value: ASTNode = parse_expression(p, PREC_ASSIGNMENT);
    let node: ASTNode = ast_node_new("AssignmentExpr", left.line, left.column);
    node.left = left;
    node.right = value;
    return node;
  }
  if (type == TOKEN_LPAREN) {
    let args_head: ASTNode = null;
    let args_tail: ASTNode = null;

    if (not parser_check(p, TOKEN_RPAREN)) {
      let first: bool = true;
      while (first or parser_match_token(p, TOKEN_COMMA)) {
        first = false;
        let arg: ASTNode = parse_expression(p, PREC_ASSIGNMENT);
        if (args_head == null) {
          args_head = arg;
          args_tail = arg;
        } else {
          args_tail.next = arg;
          args_tail = arg;
        }
      }
    }
    parser_consume(p, TOKEN_RPAREN, "Expected ')' after arguments.");
    let node: ASTNode = ast_node_new("CallExpr", left.line, left.column);
    node.callee = left;
    node.args = args_head;
    return node;
  }
  if (type == TOKEN_DOT) {
    let prop: Token = parser_consume(p, TOKEN_IDENTIFIER, "Expected property name after '.'.");
    let node: ASTNode = ast_node_new("FieldAccessExpr", left.line, left.column);
    node.object = left;
    node.property = prop.lexeme;
    return node;
  }
  if (type == TOKEN_LBRACKET) {
    let index: ASTNode = parse_expression(p, PREC_ASSIGNMENT);
    parser_consume(p, TOKEN_RBRACKET, "Expected ']' after index.");
    let node: ASTNode = ast_node_new("IndexAccessExpr", left.line, left.column);
    node.object = left;
    node.index = index;
    return node;
  }
  if (type == TOKEN_PLUS_PLUS or type == TOKEN_MINUS_MINUS) {
    let node: ASTNode = ast_node_new("PostfixExpr", left.line, left.column);
    node.left = left;
    node.op = operator.lexeme;
    return node;
  }

  print("Unexpected infix operator:", operator.lexeme);
  p.has_error = true;
  return left;
}

function is_type_args(p: Parser) -> bool {
  if (p.current == null or p.current.type != TOKEN_LESS) { return false; }
  let curr: Token = p.current.next;
  let depth: i32 = 1;
  while (curr != null and curr.type != TOKEN_EOF) {
    if (curr.type == TOKEN_LESS) { depth = depth + 1; }
    else if (curr.type == TOKEN_GREATER) { 
      depth = depth - 1; 
      if (depth == 0) {
        let after_greater: Token = curr.next;
        if (after_greater != null and (after_greater.type == TOKEN_LBRACE or after_greater.type == TOKEN_LPAREN)) {
          return true;
        }
        return false;
      }
    }
    else if (curr.type == TOKEN_SEMICOLON or curr.type == TOKEN_LBRACE) {
      return false;
    }
    curr = curr.next;
  }
  return false;
}

function try_parse_type_args(p: Parser) -> ASTNode {
  if (not parser_match_token(p, TOKEN_LESS)) { return null; }
  
  let args_head: ASTNode = null;
  let args_tail: ASTNode = null;

  let first: bool = true;
  let parsing: bool = true;
  while (parsing and (first or parser_match_token(p, TOKEN_COMMA))) {
    first = false;
    let arg: ASTNode = parse_type(p);
    if (args_head == null) {
      args_head = arg;
      args_tail = arg;
    } else {
      args_tail.next = arg;
      args_tail = arg;
    }
  }
  parser_consume(p, TOKEN_GREATER, "Expected '>' after type arguments.");
  return args_head;
}

// ── Types ──────────────────────────────────────────────────

function parse_type(p: Parser) -> ASTNode {
  let token: Token = parser_peek(p);
  let typeNode: ASTNode = null;

  if (parser_match_token(p, TOKEN_I8) or parser_match_token(p, TOKEN_I16) or parser_match_token(p, TOKEN_I32) or 
      parser_match_token(p, TOKEN_I64) or parser_match_token(p, TOKEN_F32) or parser_match_token(p, TOKEN_F64) or 
      parser_match_token(p, TOKEN_BOOL_TYPE) or parser_match_token(p, TOKEN_BYTE) or parser_match_token(p, TOKEN_STR) or 
      parser_match_token(p, TOKEN_VOID) or parser_match_token(p, TOKEN_IDENTIFIER)) {
    typeNode = ast_node_new("PrimitiveType", parser_previous(p).line, parser_previous(p).column);
    typeNode.name = parser_previous(p).lexeme;
    typeNode.typeArgs = try_parse_type_args(p);
  } else if (parser_match_token(p, TOKEN_PTR)) {
    let ptrToken: Token = parser_previous(p);
    parser_consume(p, TOKEN_LESS, "Expected '<' after 'ptr'.");
    let pointeeType: ASTNode = parse_type(p);
    parser_consume(p, TOKEN_GREATER, "Expected '>' after pointer type.");
    typeNode = ast_node_new("PointerType", ptrToken.line, ptrToken.column);
    typeNode.returnType = pointeeType; // inner type
  } else if (parser_match_token(p, TOKEN_MAP)) {
    let mapToken: Token = parser_previous(p);
    parser_consume(p, TOKEN_LESS, "Expected '<' after 'map'.");
    let valueType: ASTNode = parse_type(p);
    parser_consume(p, TOKEN_GREATER, "Expected '>' after map value type.");
    typeNode = ast_node_new("MapType", mapToken.line, mapToken.column);
    typeNode.returnType = valueType;
  } else if (parser_match_token(p, TOKEN_RESULT)) {
    let resultToken: Token = parser_previous(p);
    parser_consume(p, TOKEN_LESS, "Expected '<' after 'Result'.");
    let okType: ASTNode = parse_type(p);
    parser_consume(p, TOKEN_COMMA, "Expected ',' in Result type.");
    let errType: ASTNode = parse_type(p);
    parser_consume(p, TOKEN_GREATER, "Expected '>' after Result types.");
    typeNode = ast_node_new("ResultType", resultToken.line, resultToken.column);
    typeNode.left = okType;
    typeNode.right = errType;
  } else {
    print("Expected type.");
    p.has_error = true;
    return ast_node_new("Unknown", token.line, token.column);
  }

  // Array suffixes
  let parsing: bool = true;
  while (parsing and parser_match_token(p, TOKEN_LBRACKET)) {
    if (parser_match_token(p, TOKEN_RBRACKET)) {
      let newType: ASTNode = ast_node_new("ArrayType", typeNode.line, typeNode.column);
      newType.returnType = typeNode;
      typeNode = newType;
    } else {
      let sizeToken: Token = parser_consume(p, TOKEN_INTEGER_LITERAL, "Expected array size.");
      parser_consume(p, TOKEN_RBRACKET, "Expected ']' after array size.");
      let newType: ASTNode = ast_node_new("ArrayType", typeNode.line, typeNode.column);
      newType.returnType = typeNode;
      newType.int_val = parseI32(sizeToken.lexeme);
      typeNode = newType;
    }
  }
  
  parsing = true;
  while (parsing and parser_match_token(p, TOKEN_STAR)) {
    let newType: ASTNode = ast_node_new("PointerType", typeNode.line, typeNode.column);
    newType.returnType = typeNode;
    typeNode = newType;
  }

  if (parser_match_token(p, TOKEN_QUESTION)) {
    let newType: ASTNode = ast_node_new("NullableType", typeNode.line, typeNode.column);
    newType.returnType = typeNode;
    typeNode = newType;
  }

  return typeNode;
}

// ── Statements ─────────────────────────────────────────────

function parse_statement(p: Parser) -> ASTNode {
  if (parser_match_token(p, TOKEN_LET)) { return parse_let_statement(p); }
  if (parser_match_token(p, TOKEN_CONST)) { return parse_const_statement(p); }
  if (parser_match_token(p, TOKEN_RETURN)) { return parse_return_statement(p); }
  if (parser_match_token(p, TOKEN_IF)) { return parse_if_statement(p); }
  if (parser_match_token(p, TOKEN_WHILE)) { return parse_while_statement(p); }
  if (parser_match_token(p, TOKEN_FOR)) {
    return parse_for_statement(p);
  }
  if (parser_match_token(p, TOKEN_BREAK)) {
    return parse_break_statement(p);
  }
  if (parser_match_token(p, TOKEN_LBRACE)) { return parse_block_body(p); }

  return parse_expression_statement(p);
}

function parse_let_statement(p: Parser) -> ASTNode {
  let let_token: Token = parser_previous(p);
  let name_tok: Token = parser_consume(p, TOKEN_IDENTIFIER, "Expected variable name.");

  let typeNode: ASTNode = null;
  if (parser_match_token(p, TOKEN_COLON)) {
    typeNode = parse_type(p);
  }

  let initializer: ASTNode = null;
  if (parser_match_token(p, TOKEN_EQUALS)) {
    initializer = parse_expression(p, PREC_ASSIGNMENT);
  }

  parser_consume(p, TOKEN_SEMICOLON, "Expected ';' after variable declaration.");

  let node: ASTNode = ast_node_new("LetStatement", let_token.line, let_token.column);
  node.name = name_tok.lexeme;
  node.returnType = typeNode; // using returnType for type
  node.initializer = initializer;
  return node;
}

function parse_const_statement(p: Parser) -> ASTNode {
  let const_token: Token = parser_previous(p);
  let name_tok: Token = parser_consume(p, TOKEN_IDENTIFIER, "Expected constant name.");
  
  parser_consume(p, TOKEN_COLON, "Expected ':' after constant name.");
  let typeNode: ASTNode = parse_type(p);
  
  parser_consume(p, TOKEN_EQUALS, "Expected '=' in constant declaration.");
  let initializer: ASTNode = parse_expression(p, PREC_ASSIGNMENT);
  
  parser_consume(p, TOKEN_SEMICOLON, "Expected ';' after constant declaration.");

  let node: ASTNode = ast_node_new("ConstStatement", const_token.line, const_token.column);
  node.name = name_tok.lexeme;
  node.returnType = typeNode;
  node.initializer = initializer;
  return node;
}

function parse_return_statement(p: Parser) -> ASTNode {
  let return_token: Token = parser_previous(p);
  let value: ASTNode = null;
  
  if (not parser_check(p, TOKEN_SEMICOLON)) {
    value = parse_expression(p, PREC_ASSIGNMENT);
  }
  
  parser_consume(p, TOKEN_SEMICOLON, "Expected ';' after return value.");
  
  let node: ASTNode = ast_node_new("ReturnStatement", return_token.line, return_token.column);
  node.left = value; // using left for returned value
  return node;
}

function parse_if_statement(p: Parser) -> ASTNode {
  let if_token: Token = parser_previous(p);
  let condition: ASTNode = parse_expression(p, PREC_ASSIGNMENT);
  
  parser_consume(p, TOKEN_LBRACE, "Expected '{' after if condition.");
  let thenBlock: ASTNode = parse_block_body(p);
  
  let elseBlock: ASTNode = null;
  if (parser_match_token(p, TOKEN_ELSE)) {
    if (parser_match_token(p, TOKEN_IF)) {
      elseBlock = parse_if_statement(p);
    } else {
      parser_consume(p, TOKEN_LBRACE, "Expected '{' after else.");
      elseBlock = parse_block_body(p);
    }
  }

  let node: ASTNode = ast_node_new("IfStatement", if_token.line, if_token.column);
  node.condition = condition;
  node.body = thenBlock;
  node.else_body = elseBlock;
  return node;
}

function parse_while_statement(p: Parser) -> ASTNode {
  let while_token: Token = parser_previous(p);
  let condition: ASTNode = parse_expression(p, PREC_ASSIGNMENT);
  
  parser_consume(p, TOKEN_LBRACE, "Expected '{' after while condition.");
  let body: ASTNode = parse_block_body(p);
  
  let node: ASTNode = ast_node_new("WhileStatement", while_token.line, while_token.column);
  node.condition = condition;
  node.body = body;
  return node;
}

function parse_for_statement(p: Parser) -> ASTNode {
  let for_token: Token = parser_previous(p);

  if (parser_match_token(p, TOKEN_LPAREN)) {
    let init: ASTNode = null;
    if (parser_match_token(p, TOKEN_SEMICOLON)) {
      // no init
    } else if (parser_match_token(p, TOKEN_LET)) {
      init = parse_let_statement(p);
    } else {
      init = parse_expression_statement(p);
    }

    let condition: ASTNode = null;
    if (not parser_check(p, TOKEN_SEMICOLON)) {
      condition = parse_expression(p, PREC_ASSIGNMENT);
    }
    parser_consume(p, TOKEN_SEMICOLON, "Expected ';' after loop condition.");

    let update: ASTNode = null;
    if (not parser_check(p, TOKEN_RPAREN)) {
      update = parse_expression(p, PREC_ASSIGNMENT);
    }
    parser_consume(p, TOKEN_RPAREN, "Expected ')' after for clauses.");

    parser_consume(p, TOKEN_LBRACE, "Expected '{' after for clauses.");
    let body: ASTNode = parse_block_body(p);

    let node: ASTNode = ast_node_new("ForStatement", for_token.line, for_token.column);
    node.initializer = init;
    node.condition = condition;
    node.increment = update;
    node.body = body;
    return node;
  } else {
    // ForInStatement: for i in 0..10
    let variable: Token = parser_consume(p, TOKEN_IDENTIFIER, "Expected loop variable name.");
    parser_consume(p, TOKEN_IN, "Expected 'in' after for loop variable.");
    
    let start_expr: ASTNode = parse_expression(p, PREC_ASSIGNMENT);
    parser_consume(p, TOKEN_DOUBLE_DOT, "Expected '..' in for loop range.");
    let end_expr: ASTNode = parse_expression(p, PREC_ASSIGNMENT);
    
    parser_consume(p, TOKEN_LBRACE, "Expected '{' after range.");
    let body: ASTNode = parse_block_body(p);
    
    let node: ASTNode = ast_node_new("ForInStatement", for_token.line, for_token.column);
    node.name = variable.lexeme;
    node.left = start_expr; // start
    node.right = end_expr; // end
    node.body = body;
    return node;
  }
}

function parse_break_statement(p: Parser) -> ASTNode {
  let break_token: Token = parser_previous(p);
  parser_consume(p, TOKEN_SEMICOLON, "Expected ';' after 'break'.");
  return ast_node_new("BreakStatement", break_token.line, break_token.column);
}

function parse_expression_statement(p: Parser) -> ASTNode {
  let expr: ASTNode = parse_expression(p, PREC_ASSIGNMENT);
  parser_consume(p, TOKEN_SEMICOLON, "Expected ';' after expression.");
  let node: ASTNode = ast_node_new("ExpressionStatement", expr.line, expr.column);
  node.left = expr;
  return node;
}

function parse_block_body(p: Parser) -> ASTNode {
  let lbrace_token: Token = parser_previous(p);
  
  let stmts_head: ASTNode = null;
  let stmts_tail: ASTNode = null;

  let parsing: bool = true;
  while (parsing and not parser_check(p, TOKEN_RBRACE) and not parser_is_at_end(p)) {
    let stmt: ASTNode = parse_statement(p);
    if (stmts_head == null) {
      stmts_head = stmt;
      stmts_tail = stmt;
    } else {
      stmts_tail.next = stmt;
      stmts_tail = stmt;
    }
  }
  parser_consume(p, TOKEN_RBRACE, "Expected '}' after block.");
  
  let node: ASTNode = ast_node_new("Block", lbrace_token.line, lbrace_token.column);
  node.body = stmts_head;
  return node;
}

function parse_struct_literal(p: Parser, ident: ASTNode) -> ASTNode {
  parser_consume(p, TOKEN_LBRACE, "Expected '{' for struct literal.");
  let fields_head: ASTNode = null;
  let fields_tail: ASTNode = null;

  let parsing: bool = true;
  if (not parser_check(p, TOKEN_RBRACE)) {
    let first: bool = true;
    while (parsing and (first or parser_match_token(p, TOKEN_COMMA))) {
      first = false;
      let name_tok: Token = parser_consume(p, TOKEN_IDENTIFIER, "Expected field name.");
      parser_consume(p, TOKEN_COLON, "Expected ':' after field name.");
      let value: ASTNode = parse_expression(p, PREC_ASSIGNMENT);
      
      let field: ASTNode = ast_node_new("StructLiteralField", name_tok.line, name_tok.column);
      field.name = name_tok.lexeme;
      field.right = value;

      if (fields_head == null) {
        fields_head = field;
        fields_tail = field;
      } else {
        fields_tail.next = field;
        fields_tail = field;
      }
    }
  }
  parser_consume(p, TOKEN_RBRACE, "Expected '}' after struct fields.");
  let node: ASTNode = ast_node_new("StructLiteral", ident.line, ident.column);
  node.name = ident.name;
  node.fields = fields_head;
  node.typeArgs = ident.typeArgs;
  return node;
}

// ── Declarations ───────────────────────────────────────────

function parse_import_decl(p: Parser) -> ASTNode {
  let import_token: Token = parser_previous(p);
  let path_token: Token = parser_consume(p, TOKEN_STRING_LITERAL, "Expected string path after 'import'.");
  parser_consume(p, TOKEN_SEMICOLON, "Expected ';' after import declaration.");

  let node: ASTNode = ast_node_new("ImportDecl", import_token.line, import_token.column);
  node.str_val = path_token.lexeme;
  return node;
}

function parse_declaration(p: Parser) -> ASTNode {
  if (parser_match_token(p, TOKEN_STRUCT)) {
    return parse_struct_decl(p);
  }
  if (parser_match_token(p, TOKEN_FUNCTION) or parser_match_token(p, TOKEN_FN)) {
    return parse_function_decl(p);
  }
  if (parser_match_token(p, TOKEN_CONST)) {
    return parse_const_statement(p);
  }
  print("Parse Error at line " + toString(parser_peek(p).line) + " col " + toString(parser_peek(p).column) + " : Expected 'struct', 'function', 'fn', or 'const' declaration.");
  p.has_error = true;
  exit(1);
  return ast_node_new("Unknown", parser_peek(p).line, parser_peek(p).column);
}

function parse_generic_params(p: Parser) -> ASTNode {
  if (not parser_match_token(p, TOKEN_LESS)) { return null; }
  let params_head: ASTNode = null;
  let params_tail: ASTNode = null;

  let first: bool = true;
  let parsing: bool = true;
  while (parsing and (first or parser_match_token(p, TOKEN_COMMA))) {
    first = false;
    let name_tok: Token = parser_consume(p, TOKEN_IDENTIFIER, "Expected generic parameter name.");
    let param: ASTNode = ast_node_new("TypeParam", name_tok.line, name_tok.column);
    param.name = name_tok.lexeme;

    if (params_head == null) {
      params_head = param;
      params_tail = param;
    } else {
      params_tail.next = param;
      params_tail = param;
    }
  }
  parser_consume(p, TOKEN_GREATER, "Expected '>' after generic parameters.");
  return params_head;
}

function parse_struct_decl(p: Parser) -> ASTNode {
  let struct_token: Token = parser_previous(p);
  let name_token: Token = parser_consume(p, TOKEN_IDENTIFIER, "Expected struct name.");
  let typeParams: ASTNode = parse_generic_params(p);
  
  parser_consume(p, TOKEN_LBRACE, "Expected '{' before struct body.");
  
  let fields_head: ASTNode = null;
  let fields_tail: ASTNode = null;

  let parsing: bool = true;
  while (parsing and not parser_check(p, TOKEN_RBRACE) and not parser_is_at_end(p)) {
    let field_name_tok: Token = parser_consume(p, TOKEN_IDENTIFIER, "Expected field name.");
    parser_consume(p, TOKEN_COLON, "Expected ':' after field name.");
    let field_type: ASTNode = parse_type(p);
    parser_consume(p, TOKEN_SEMICOLON, "Expected ';' after struct field.");
    
    let field: ASTNode = ast_node_new("StructField", field_name_tok.line, field_name_tok.column);
    field.name = field_name_tok.lexeme;
    field.returnType = field_type;

    if (fields_head == null) {
      fields_head = field;
      fields_tail = field;
    } else {
      fields_tail.next = field;
      fields_tail = field;
    }
  }
  parser_consume(p, TOKEN_RBRACE, "Expected '}' after struct body.");
  
  let node: ASTNode = ast_node_new("StructDecl", struct_token.line, struct_token.column);
  node.name = name_token.lexeme;
  node.fields = fields_head;
  node.typeParams = typeParams;
  return node;
}

function parse_function_decl(p: Parser) -> ASTNode {
  let fn_token: Token = parser_previous(p);
  let name_token: Token = parser_consume(p, TOKEN_IDENTIFIER, "Expected function name.");
  let typeParams: ASTNode = parse_generic_params(p);
  
  parser_consume(p, TOKEN_LPAREN, "Expected '(' after function name.");
  
  let params_head: ASTNode = null;
  let params_tail: ASTNode = null;

  if (not parser_check(p, TOKEN_RPAREN)) {
    let first: bool = true;
    let parsing: bool = true;
    while (parsing and (first or parser_match_token(p, TOKEN_COMMA))) {
      first = false;
      let param_name_tok: Token = parser_consume(p, TOKEN_IDENTIFIER, "Expected parameter name.");
      parser_consume(p, TOKEN_COLON, "Expected ':' after parameter name.");
      let param_type: ASTNode = parse_type(p);
      
      let param: ASTNode = ast_node_new("FunctionParam", param_name_tok.line, param_name_tok.column);
      param.name = param_name_tok.lexeme;
      param.returnType = param_type;

      if (params_head == null) {
        params_head = param;
        params_tail = param;
      } else {
        params_tail.next = param;
        params_tail = param;
      }
    }
  }
  parser_consume(p, TOKEN_RPAREN, "Expected ')' after parameters.");

  let returnType: ASTNode = null;
  if (parser_match_token(p, TOKEN_ARROW)) {
    if (parser_match_token(p, TOKEN_VOID)) {
      // returnType stays null
    } else {
      returnType = parse_type(p);
    }
  }

  parser_consume(p, TOKEN_LBRACE, "Expected '{' before function body.");
  let body: ASTNode = parse_block_body(p);

  let node: ASTNode = ast_node_new("FunctionDecl", fn_token.line, fn_token.column);
  node.name = name_token.lexeme;
  node.params = params_head;
  node.returnType = returnType;
  node.body = body;
  node.typeParams = typeParams;
  return node;
}

function parse_program(p: Parser) -> ASTNode {
  let imports_head: ASTNode = null;
  let imports_tail: ASTNode = null;
  let decls_head: ASTNode = null;
  let decls_tail: ASTNode = null;

  let parsing: bool = true;
  while (parsing and not parser_is_at_end(p)) {
    if (parser_match_token(p, TOKEN_IMPORT)) {
      let imp: ASTNode = parse_import_decl(p);
      if (imports_head == null) {
        imports_head = imp;
        imports_tail = imp;
      } else {
        imports_tail.next = imp;
        imports_tail = imp;
      }
    } else {
      let decl: ASTNode = parse_declaration(p);
      if (decls_head == null) {
        decls_head = decl;
        decls_tail = decl;
      } else {
        decls_tail.next = decl;
        decls_tail = decl;
      }
    }
  }

  let node: ASTNode = ast_node_new("Program", 1, 1);
  node.left = imports_head; // using left for imports
  node.right = decls_head;  // using right for declarations
  return node;
}

function parse(tokens: Token) -> Parser {
  let p: Parser = parser_new(tokens);
  p.ast = parse_program(p);
  return p;
}
