// vektor-compiler/pkg.vk
// Self-hosted package manager for Vektor

function init_project(dir: str) -> void {
  let manifest_path: str = dir + "/vektor.json";
  if (file_exists(manifest_path)) {
    print("vektor.json already exists. Skipping init.");
    return;
  }
  
  let manifest: str = "{\n  \"name\": \"my-project\",\n  \"version\": \"1.0.0\",\n  \"entry\": \"main.vk\",\n  \"dependencies\": {}\n}\n";
  write_file(manifest_path, manifest);
  
  let entry_path: str = dir + "/main.vk";
  if (not file_exists(entry_path)) {
    write_file(entry_path, "function main() {\n    print(\"Hello from my-project\");\n}\n");
  }
  
  print("Initialized Vektor project at", dir);
  print("Created vektor.json and main.vk");
}

function install_single(dir: str, name: str, source: str) -> void {
  let modules_dir: str = dir + "/vk_modules";
  mkdir(modules_dir);
  
  let dest: str = modules_dir + "/" + name;
  if (file_exists(dest)) {
    print("  " + name + " - already installed, skipping");
    return;
  }
  
  if (charAt(source, 0) == "." or charAt(source, 0) == "/") {
    // Local copy
    print("  " + name + " - copying from local path " + source);
    shell_exec("powershell -c \"Copy-Item -Recurse -Force '" + source + "' '" + dest + "'\"");
  } else {
    // Git clone
    print("  " + name + " - cloning from " + source + "...");
    shell_exec("git clone --depth 1 \"" + source + "\" \"" + dest + "\"");
  }
  
  // Recursively install dependencies
  let nested_manifest: str = dest + "/vektor.json";
  if (file_exists(nested_manifest)) {
    let raw: str = read_file(nested_manifest);
    let parsed: map<any> = parse_json(raw);
    if (parsed != null and map_has(parsed, "dependencies")) {
      let deps: map<any> = map_get(parsed, "dependencies");
      let keys: str[] = map_keys(deps);
      let i: i32 = 0;
      while (i < array_length(keys)) {
        let dep_name: str = keys[i];
        let dep_source: str = map_get_string(deps, dep_name);
        install_single(dir, dep_name, dep_source);
        i = i + 1;
      }
    }
  }
}

function install_all(dir: str) -> void {
  let manifest_path: str = dir + "/vektor.json";
  if (not file_exists(manifest_path)) {
    print("No vektor.json found. Run 'vks pkg init' first.");
    return;
  }
  
  let raw: str = read_file(manifest_path);
  let manifest: map<any> = parse_json(raw);
  
  if (manifest == null) {
    print("Failed to parse vektor.json");
    return;
  }
  
  if (map_has(manifest, "dependencies")) {
    let deps: map<any> = map_get(manifest, "dependencies");
    let keys: str[] = map_keys(deps);
    let i: i32 = 0;
    while (i < array_length(keys)) {
      let dep_name: str = keys[i];
      let dep_source: str = map_get_string(deps, dep_name);
      install_single(dir, dep_name, dep_source);
      i = i + 1;
    }
  }
  print("Done.");
}


