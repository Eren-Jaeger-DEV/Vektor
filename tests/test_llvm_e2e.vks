struct Point {
    x: i32;
    y: i32;
}

function main() -> i32 {
    print("--- E2E Test ---");

    let p: Point = Point { x: 10, y: 20 };
    print("Point X:");
    print(p.x);
    print("Point Y:");
    print(p.y);
    
    let arr: i32[] = [1, 2, 3];
    array_push(arr, p.x);
    array_push(arr, p.y);
    
    print("Array lengths and elements:");
    let sum: i32 = 0;
    for (let i: i32 = 0; i < 5; i++) {
        print(arr[i]);
        sum = sum + arr[i];
    }
    
    print("Sum:");
    print(sum);
    
    let res: Result<i32, str> = Ok(sum);
    if (res.ok) {
        print("Result OK. Value:");
        print(res.value);
    }
    
    let msg: str = "Test" + " Complete!";
    print(msg);

    return 0;
}
