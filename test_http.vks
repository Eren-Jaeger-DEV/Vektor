fn http_get(host: str, path: str) -> str {
    let sock: i8* = tcp_connect(host, 80);
    if sock == null {
        print("Failed to connect");
        return "";
    }
    
    let req: str = "GET " + path + " HTTP/1.1\r\nHost: " + host + "\r\nConnection: close\r\n\r\n";
    socket_send(sock, req);
    
    // The second argument `8192` is now ignored in llvm-emitter, but kept in syntax to match Phase 8 specs until changed.
    let response: str = socket_recv(sock, 8192);
    socket_close(sock);
    return response;
}

fn main() {
    print("Fetching http://example.com/ ...");
    let response: str = http_get("example.com", "/");
    
    // Split by double CRLF to separate headers from body
    let parts: str[] = str_split(response, "\r\n\r\n");
    let num_parts: i32 = array_length(parts);
    
    if num_parts < 2 {
        print("Invalid HTTP response or connection closed early.");
        free_str_array(parts);
        return;
    }
    
    let headers_part: str = parts[0];
    let body_part: str = parts[1];
    
    // Split headers into lines
    let headers: str[] = str_split(headers_part, "\r\n");
    let num_headers: i32 = array_length(headers);
    
    print("----- STATUS LINE -----");
    print(headers[0]);
    
    print("----- META -----");
    // We subtract 1 from total headers because the first line is the status line
    let count: i32 = num_headers;
    count--;
    print("Total Headers Parsed:", count);
    
    print("----- BODY PREVIEW -----");
    // Print the first line of the body if any
    let body_lines: str[] = str_split(body_part, "\n");
    if array_length(body_lines) > 0 {
        print(body_lines[0]);
    } else {
        print("Body is empty.");
    }
    
    free_str_array(body_lines);
    free_str_array(headers);
    free_str_array(parts);
    
    print("Networking test completed successfully.");
}
