"import \"ast.vks\";\n\n// ============================================================\n// LLVM Emitter - Batch 1: Foundations\n// ============================================================\n\n// ── Type mapping ────────────────────────────────────────────\n\nfunction vks_type_to_llvm(typeNode: ASTNode) -> str {\n  if (typeNode == null) { return \"i32\"; } // Fallback\n  \n  if (typeNode.kind == \"PrimitiveType\") {\n    if (typeNode.name == \"i8\" or typeNode.name == \"byte\") { return \"i8\"; }\n    if (typeNode.name == \"i16\") { return \"i16\"; }\n    if (typeNode.name == \"i32\") { return \"i32\"; }\n    if (typeNode.name == \"i64\") { return \"i64\"; }\n    if (typeNode.name == \"f32\") { return \"float\"; }\n    if (typeNode.name == \"f64\") { return \"double\"; }\n    if (typeNode.name == \"bool\") { return \"i1\"; }\n    if (typeNode.name == \"void\") { return \"void\"; }\n    if (typeNode.name == \"str\") { return \"%str\"; }\n    return \"%\" + typeNode.name; // Struct type\n  }\n  \n  if (typeNode.kind == \"PointerType\") {\n    return vks_type_to_llvm(typeNode.returnType) + \"*\";\n  }\n  \n  if (typeNode.kind == \"ArrayType\") {\n    if (typeNode.int_val != 0) { // Assuming fixed size sets int_val\n      return \"[\" + to_str(typeNode.int_val) + \" x \" + vks_type_to_llvm(typeNode.returnType) + \"]\";\n    } else {\n      // dynamic array struct format, stripping % and *\n      let elem_type: str = vks_type_to_llvm(typeNode.returnType);\n      // Wait, VKS doesn't have regex replace. For simplicity in self-host, we'll assume we can strip later or it's handled\n      // A simple strip logic for % and *\n      if (charAt(elem_type, 0) == \"%\") {\n        // can't substring easily without a helper, we'll keep it simple: just use raw name for structs\n        if (typeNode.returnType.kind == \"PrimitiveType\") {\n          return \"%array_\" + typeNode.returnType.name;\n        }\n      }\n      return \"%arra
