function test_strings() -> void {
  let s1: str = "hello";
  let s2: str = " world";
  let s3: str = s1 + s2;
  
  if (s3 == "hello world") {
    print(101); // success
  } else {
    print(404); // error
  }
  
  if (s1 != s2) {
    print(102); // success
  } else {
    print(404); // error
  }
}

function test_result(flag: bool) -> Result<i32, str> {
  if (flag) {
    return Ok(42);
  } else {
    return Err("failure");
  }
}

function test_result_handling() -> void {
  let r1: Result<i32, str> = test_result(true);
  if (r1.ok) {
    print(r1.value); // should print 42
  } else {
    print(999);
  }
  
  let r2: Result<i32, str> = test_result(false);
  if (not r2.ok) {
    if (r2.error == "failure") {
      print(103); // success
    } else {
      print(999);
    }
  } else {
    print(999);
  }
}

function main() -> i32 {
  test_strings();
  test_result_handling();
  return 0;
}
