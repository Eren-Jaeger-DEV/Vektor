function is_alpha(c: str) -> bool {
  return (c >= "a" and c <= "z") or
         (c >= "A" and c <= "Z") or
         c == "_";
}
function is_digit(c: str) -> bool {
  return c >= "0" and c <= "9";
}
function is_alphanumeric(c: str) -> bool {
  return is_alpha(c) or is_digit(c);
}

function main() {
  print(is_alphanumeric(""));
}
