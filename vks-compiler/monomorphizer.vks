import "ast.vks";

// ============================================================
// Monomorphizer (Generic Instantiation)
// ============================================================

struct MonoState {
  generic_structs: ASTNode; // Linked list of StructDecl with typeParams
  generic_funcs: ASTNode;   // Linked list of FunctionDecl with typeParams
  
  specialized_decls_head: ASTNode;
  specialized_decls_tail: ASTNode;
  
  // To prevent infinite instantiation, we track already specialized names.
  // We can just use a linked list of simple nodes where name = instantiated_name
  instantiated_names: ASTNode; 
}

function mono_state_new() -> MonoState {
  return MonoState {
    generic_structs: null,
    generic_funcs: null,
    specialized_decls_head: null,
    specialized_decls_tail: null,
    instantiated_names: null
  };
}

// ── Pass 1: Clone AST ───────────────────────────────────────

function clone_ast_node(node: ASTNode) -> ASTNode {
  if (node == null) { return null; }
  
  let new_node: ASTNode = ast_node_new(node.kind, node.line, node.column);
  new_node.name = node.name;
  new_node.int_val = node.int_val;
  new_node.float_val = node.float_val;
  new_node.str_val = node.str_val;
  new_node.bool_val = node.bool_val;
  new_node.op = node.op;
  new_node.property = node.property;
  
  new_node.left = clone_ast_list(node.left);
  new_node.right = clone_ast_list(node.right);
  new_node.condition = clone_ast_node(node.condition);
  new_node.body = clone_ast_list(node.body);
  new_node.else_body = clone_ast_list(node.else_body);
  new_node.initializer = clone_ast_node(node.initializer);
  new_node.increment = clone_ast_node(node.increment);
  new_node.callee = clone_ast_node(node.callee);
  new_node.args = clone_ast_list(node.args);
  new_node.object = clone_ast_node(node.object);
  new_node.index = clone_ast_node(node.index);
  new_node.fields = clone_ast_list(node.fields);
  new_node.params = clone_ast_list(node.params);
  new_node.returnType = clone_ast_node(node.returnType);
  new_node.typeParams = clone_ast_list(node.typeParams);
  new_node.typeArgs = clone_ast_list(node.typeArgs);
  
  return new_node;
}

function clone_ast_list(head: ASTNode) -> ASTNode {
  if (head == null) { return null; }
  let new_head: ASTNode = clone_ast_node(head);
  let curr: ASTNode = head.next;
  let new_curr: ASTNode = new_head;
  while (curr != null) {
    let cloned_next: ASTNode = clone_ast_node(curr);
    new_curr.next = cloned_next;
    new_curr = cloned_next;
    curr = curr.next;
  }
  return new_head;
}

// ── Pass 2 & 3: Substitution ───────────────────────────────

struct Substitution {
  param_name: str;
  concrete_type: ASTNode;
  next: Substitution;
}

function format_type_name(typeNode: ASTNode) -> str {
  if (typeNode == null) { return "Unknown"; }
  if (typeNode.kind == "PrimitiveType") {
    let base: str = typeNode.name;
    if (typeNode.typeArgs != null) {
      let curr: ASTNode = typeNode.typeArgs;
      while (curr != null) {
        base = base + "_" + format_type_name(curr);
        curr = curr.next;
      }
    }
    return base;
  }
  if (typeNode.kind == "ArrayType") {
    return format_type_name(typeNode.returnType) + "Array";
  }
  if (typeNode.kind == "PointerType") {
    return format_type_name(typeNode.returnType) + "Ptr";
  }
  if (typeNode.kind == "NullableType") {
    return format_type_name(typeNode.returnType) + "Nullable";
  }
  if (typeNode.kind == "ResultType") {
    return "Result_" + format_type_name(typeNode.left) + "_" + format_type_name(typeNode.right);
  }
  if (typeNode.kind == "MapType") {
    return "Map_" + format_type_name(typeNode.returnType);
  }
  return "Unknown";
}

function has_substitution(subs: Substitution, name: str) -> bool {
  let curr: Substitution = subs;
  while (curr != null) {
    if (curr.param_name == name) { return true; }
    curr = curr.next;
  }
  return false;
}

function get_substitution(subs: Substitution, name: str) -> ASTNode {
  let curr: Substitution = subs;
  while (curr != null) {
    if (curr.param_name == name) { return curr.concrete_type; }
    curr = curr.next;
  }
  return null;
}

function check_instantiated(state: MonoState, name: str) -> bool {
  let curr: ASTNode = state.instantiated_names;
  while (curr != null) {
    if (curr.name == name) { return true; }
    curr = curr.next;
  }
  return false;
}

function mark_instantiated(state: MonoState, name: str) -> void {
  let node: ASTNode = ast_node_new("InstantiatedMarker", 0, 0);
  node.name = name;
  node.next = state.instantiated_names;
  state.instantiated_names = node;
}

function get_generic_struct(state: MonoState, name: str) -> ASTNode {
  let curr: ASTNode = state.generic_structs;
  while (curr != null) {
    if (curr.name == name) { return curr; }
    curr = curr.next;
  }
  return null;
}

function get_generic_func(state: MonoState, name: str) -> ASTNode {
  let curr: ASTNode = state.generic_funcs;
  while (curr != null) {
    if (curr.name == name) { return curr; }
    curr = curr.next;
  }
  return null;
}

// Mutually recursive visit functions

function instantiate_struct(state: MonoState, genericName: str, typeArgs: ASTNode, subs: Substitution) -> str {
  let decl: ASTNode = get_generic_struct(state, genericName);
  if (decl == null) {
    // Not a known generic struct, just join name
    let base: str = genericName;
    let curr: ASTNode = typeArgs;
    while (curr != null) {
      base = base + "_" + format_type_name(curr);
      curr = curr.next;
    }
    return base;
  }

  let specializedName: str = genericName;
  let curr_arg: ASTNode = typeArgs;
  while (curr_arg != null) {
    specializedName = specializedName + "_" + format_type_name(curr_arg);
    curr_arg = curr_arg.next;
  }

  if (not check_instantiated(state, specializedName)) {
    mark_instantiated(state, specializedName);

    let newDecl: ASTNode = clone_ast_node(decl);
    newDecl.name = specializedName;
    newDecl.typeParams = null;

    let newSubs: Substitution = null;
    let curr_param: ASTNode = decl.typeParams;
    curr_arg = typeArgs;

    while (curr_param != null and curr_arg != null) {
      let sub: Substitution = Substitution {
        param_name: curr_param.name,
        concrete_type: curr_arg,
        next: newSubs
      };
      newSubs = sub;
      curr_param = curr_param.next;
      curr_arg = curr_arg.next;
    }

    if (state.specialized_decls_head == null) {
      state.specialized_decls_head = newDecl;
      state.specialized_decls_tail = newDecl;
    } else {
      state.specialized_decls_tail.next = newDecl;
      state.specialized_decls_tail = newDecl;
    }

    visit_declaration(state, newDecl, newSubs);
  }

  return specializedName;
}

function instantiate_function(state: MonoState, genericName: str, typeArgs: ASTNode, subs: Substitution) -> str {
  let decl: ASTNode = get_generic_func(state, genericName);
  if (decl == null) {
    let base: str = genericName;
    let curr: ASTNode = typeArgs;
    while (curr != null) {
      base = base + "_" + format_type_name(curr);
      curr = curr.next;
    }
    return base;
  }

  let specializedName: str = genericName;
  let curr_arg: ASTNode = typeArgs;
  while (curr_arg != null) {
    specializedName = specializedName + "_" + format_type_name(curr_arg);
    curr_arg = curr_arg.next;
  }

  if (not check_instantiated(state, specializedName)) {
    mark_instantiated(state, specializedName);

    let newDecl: ASTNode = clone_ast_node(decl);
    newDecl.name = specializedName;
    newDecl.typeParams = null;

    let newSubs: Substitution = null;
    let curr_param: ASTNode = decl.typeParams;
    curr_arg = typeArgs;

    while (curr_param != null and curr_arg != null) {
      let sub: Substitution = Substitution {
        param_name: curr_param.name,
        concrete_type: curr_arg,
        next: newSubs
      };
      newSubs = sub;
      curr_param = curr_param.next;
      curr_arg = curr_arg.next;
    }

    if (state.specialized_decls_head == null) {
      state.specialized_decls_head = newDecl;
      state.specialized_decls_tail = newDecl;
    } else {
      state.specialized_decls_tail.next = newDecl;
      state.specialized_decls_tail = newDecl;
    }

    visit_declaration(state, newDecl, newSubs);
  }

  return specializedName;
}

function visit_type(state: MonoState, typeNode: ASTNode, subs: Substitution) -> ASTNode {
  if (typeNode == null) { return null; }

  if (typeNode.kind == "PrimitiveType") {
    if (has_substitution(subs, typeNode.name) and typeNode.typeArgs == null) {
      return clone_ast_node(get_substitution(subs, typeNode.name));
    }

    if (typeNode.typeArgs != null) {
      let curr_arg: ASTNode = typeNode.typeArgs;
      while (curr_arg != null) {
        let visited_arg: ASTNode = visit_type(state, curr_arg, subs);
        // We mutate in place for simplicity
        curr_arg.kind = visited_arg.kind;
        curr_arg.name = visited_arg.name;
        curr_arg.typeArgs = visited_arg.typeArgs;
        curr_arg.returnType = visited_arg.returnType;
        curr_arg = curr_arg.next;
      }

      let newName: str = instantiate_struct(state, typeNode.name, typeNode.typeArgs, subs);
      typeNode.name = newName;
      typeNode.typeArgs = null;
    }
  } else if (typeNode.kind == "ArrayType") {
    typeNode.returnType = visit_type(state, typeNode.returnType, subs);
  } else if (typeNode.kind == "PointerType") {
    typeNode.returnType = visit_type(state, typeNode.returnType, subs);
  } else if (typeNode.kind == "NullableType") {
    typeNode.returnType = visit_type(state, typeNode.returnType, subs);
  } else if (typeNode.kind == "ResultType") {
    typeNode.left = visit_type(state, typeNode.left, subs);
    typeNode.right = visit_type(state, typeNode.right, subs);
  } else if (typeNode.kind == "MapType") {
    typeNode.returnType = visit_type(state, typeNode.returnType, subs);
  }

  return typeNode;
}

function visit_expression(state: MonoState, expr: ASTNode, subs: Substitution) -> void {
  if (expr == null) { return; }

  if (expr.kind == "BinaryExpr") {
    visit_expression(state, expr.left, subs);
    visit_expression(state, expr.right, subs);
  } else if (expr.kind == "UnaryExpr" or expr.kind == "PostfixExpr" or expr.kind == "CloneExpr") {
    visit_expression(state, expr.left, subs);
    if (expr.right != null) { visit_expression(state, expr.right, subs); }
  } else if (expr.kind == "CallExpr") {
    visit_expression(state, expr.callee, subs);
    let curr_arg: ASTNode = expr.args;
    while (curr_arg != null) {
      visit_expression(state, curr_arg, subs);
      curr_arg = curr_arg.next;
    }
  } else if (expr.kind == "FieldAccessExpr") {
    visit_expression(state, expr.object, subs);
  } else if (expr.kind == "IndexAccessExpr") {
    visit_expression(state, expr.object, subs);
    visit_expression(state, expr.index, subs);
  } else if (expr.kind == "AssignmentExpr") {
    visit_expression(state, expr.left, subs);
    visit_expression(state, expr.right, subs);
  } else if (expr.kind == "CastExpr") {
    expr.returnType = visit_type(state, expr.returnType, subs);
    visit_expression(state, expr.left, subs);
  } else if (expr.kind == "AllocExpr") {
    visit_expression(state, expr.left, subs);
  } else if (expr.kind == "ArrayLiteral") {
    let curr_arg: ASTNode = expr.args;
    while (curr_arg != null) {
      visit_expression(state, curr_arg, subs);
      curr_arg = curr_arg.next;
    }
  } else if (expr.kind == "StructLiteral") {
    if (expr.typeArgs != null) {
      let curr_arg: ASTNode = expr.typeArgs;
      while (curr_arg != null) {
        let visited_arg: ASTNode = visit_type(state, curr_arg, subs);
        curr_arg.kind = visited_arg.kind;
        curr_arg.name = visited_arg.name;
        curr_arg.typeArgs = visited_arg.typeArgs;
        curr_arg.returnType = visited_arg.returnType;
        curr_arg = curr_arg.next;
      }
      expr.name = instantiate_struct(state, expr.name, expr.typeArgs, subs);
      expr.typeArgs = null;
    }
    let curr_field: ASTNode = expr.fields;
    while (curr_field != null) {
      visit_expression(state, curr_field.right, subs);
      curr_field = curr_field.next;
    }
  } else if (expr.kind == "Identifier") {
    if (expr.typeArgs != null) {
      let curr_arg: ASTNode = expr.typeArgs;
      while (curr_arg != null) {
        let visited_arg: ASTNode = visit_type(state, curr_arg, subs);
        curr_arg.kind = visited_arg.kind;
        curr_arg.name = visited_arg.name;
        curr_arg.typeArgs = visited_arg.typeArgs;
        curr_arg.returnType = visited_arg.returnType;
        curr_arg = curr_arg.next;
      }
      expr.name = instantiate_function(state, expr.name, expr.typeArgs, subs);
      expr.typeArgs = null;
    }
  } else if (expr.kind == "SpawnExpr") {
    visit_expression(state, expr.left, subs);
  }
}

function visit_statement(state: MonoState, stmt: ASTNode, subs: Substitution) -> void {
  if (stmt == null) { return; }

  if (stmt.kind == "LetStatement" or stmt.kind == "ConstStatement") {
    stmt.returnType = visit_type(state, stmt.returnType, subs);
    visit_expression(state, stmt.initializer, subs);
  } else if (stmt.kind == "ExpressionStatement") {
    visit_expression(state, stmt.left, subs);
  } else if (stmt.kind == "ReturnStatement") {
    visit_expression(state, stmt.left, subs);
  } else if (stmt.kind == "IfStatement") {
    visit_expression(state, stmt.condition, subs);
    visit_block(state, stmt.body, subs);
    if (stmt.else_body != null) {
      if (stmt.else_body.kind == "Block") {
        visit_block(state, stmt.else_body, subs);
      } else {
        visit_statement(state, stmt.else_body, subs);
      }
    }
  } else if (stmt.kind == "WhileStatement") {
    visit_expression(state, stmt.condition, subs);
    visit_block(state, stmt.body, subs);
  } else if (stmt.kind == "ForStatement") {
    visit_statement(state, stmt.initializer, subs);
    visit_expression(state, stmt.condition, subs);
    visit_expression(state, stmt.increment, subs);
    visit_block(state, stmt.body, subs);
  } else if (stmt.kind == "ForInStatement") {
    visit_expression(state, stmt.left, subs);
    visit_expression(state, stmt.right, subs);
    visit_block(state, stmt.body, subs);
  }
}

function visit_block(state: MonoState, block: ASTNode, subs: Substitution) -> void {
  if (block == null) { return; }
  let curr: ASTNode = block.body;
  while (curr != null) {
    visit_statement(state, curr, subs);
    curr = curr.next;
  }
}

function visit_declaration(state: MonoState, decl: ASTNode, subs: Substitution) -> void {
  if (decl.kind == "StructDecl") {
    let curr_field: ASTNode = decl.fields;
    while (curr_field != null) {
      curr_field.returnType = visit_type(state, curr_field.returnType, subs);
      curr_field = curr_field.next;
    }
  } else if (decl.kind == "FunctionDecl") {
    let curr_param: ASTNode = decl.params;
    while (curr_param != null) {
      curr_param.returnType = visit_type(state, curr_param.returnType, subs);
      curr_param = curr_param.next;
    }
    decl.returnType = visit_type(state, decl.returnType, subs);
    visit_block(state, decl.body, subs);
  }
}

// ── Entry Point ──────────────────────────────────────────────

function monomorphize(program: ASTNode) -> ASTNode {
  let new_program: ASTNode = clone_ast_node(program);
  let state: MonoState = mono_state_new();
  
  let non_generic_decls_head: ASTNode = null;
  let non_generic_decls_tail: ASTNode = null;

  // Pass 1: Collect generics
  let curr_decl: ASTNode = new_program.right; // declarations are stored in right
  while (curr_decl != null) {
    let next_decl: ASTNode = curr_decl.next;
    curr_decl.next = null; // Detach from list temporarily
    
    if (curr_decl.kind == "StructDecl" and curr_decl.typeParams != null) {
      curr_decl.next = state.generic_structs;
      state.generic_structs = curr_decl;
    } else if (curr_decl.kind == "FunctionDecl" and curr_decl.typeParams != null) {
      curr_decl.next = state.generic_funcs;
      state.generic_funcs = curr_decl;
    } else {
      if (non_generic_decls_head == null) {
        non_generic_decls_head = curr_decl;
        non_generic_decls_tail = curr_decl;
      } else {
        non_generic_decls_tail.next = curr_decl;
        non_generic_decls_tail = curr_decl;
      }
    }
    curr_decl = next_decl;
  }

  new_program.right = non_generic_decls_head;

  // Pass 2: Traverse and instantiate
  curr_decl = non_generic_decls_head;
  while (curr_decl != null) {
    visit_declaration(state, curr_decl, null);
    curr_decl = curr_decl.next;
  }

  // Pass 3: Append newly instantiated declarations
  if (non_generic_decls_tail == null) {
    new_program.right = state.specialized_decls_head;
  } else {
    non_generic_decls_tail.next = state.specialized_decls_head;
  }

  return new_program;
}
