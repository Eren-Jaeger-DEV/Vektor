import "ast.vks";

// ============================================================
// LLVM Emitter - Batch 1: Foundations
// ============================================================

// ── Type mapping ────────────────────────────────────────────

function vks_type_to_llvm(typeNode: ASTNode) -> str {
  if (typeNode == null) { return "i32"; } // Fallback
  
  if (typeNode.kind == "PrimitiveType") {
    if (typeNode.name == "i8" or typeNode.name == "byte") { return "i8"; }
    if (typeNode.name == "i16") { return "i16"; }
    if (typeNode.name == "i32") { return "i32"; }
    if (typeNode.name == "i64") { return "i64"; }
    if (typeNode.name == "f32") { return "float"; }
    if (typeNode.name == "f64") { return "double"; }
    if (typeNode.name == "bool") { return "i1"; }
    if (typeNode.name == "void") { return "void"; }
    if (typeNode.name == "str") { return "%str"; }
    return "%" + typeNode.name; // Struct type
  }
  
  if (typeNode.kind == "PointerType") {
    return vks_type_to_llvm(typeNode.returnType) + "*";
  }
  
  if (typeNode.kind == "ArrayType") {
    if (typeNode.int_val != 0) { // Assuming fixed size sets int_val
      return "[" + toString(typeNode.int_val) + " x " + vks_type_to_llvm(typeNode.returnType) + "]";
    } else {
      // dynamic array struct format, stripping % and *
      let elem_type: str = vks_type_to_llvm(typeNode.returnType);
      // Wait, VKS doesn't have regex replace. For simplicity in self-host, we'll assume we can strip later or it's handled
      // A simple strip logic for % and *
      if (charAt(elem_type, 0) == "%") {
        // can't substring easily without a helper, we'll keep it simple: just use raw name for structs
        if (typeNode.returnType.kind == "PrimitiveType") {
          return "%array_" + typeNode.returnType.name;
        }
      }
      return "%array_dynamic"; // Fallback, we'll refine string manipulation later
    }
  }
  
  if (typeNode.kind == "NullableType") {
    return vks_type_to_llvm(typeNode.returnType) + "*";
  }
  
  if (typeNode.kind == "ResultType") {
    // VKS doesn't have regex replace easily.
    return "%Result_Type"; // Placeholder, refine later
  }
  
  return "i32";
}

function llvm_type_size(llvmType: str) -> i32 {
  if (llvmType == "i8" or llvmType == "i1") { return 1; }
  if (llvmType == "i16") { return 2; }
  if (llvmType == "i32" or llvmType == "float") { return 4; }
  if (llvmType == "i64" or llvmType == "double" or llvmType == "%str") { return 8; }
  // default
  return 8; 
}

// ── Scope for Type Lookups ──────────────────────────────────

struct ScopeEntry {
  name: str;
  type: str;
  next: ScopeEntry;
}

struct Scope {
  locals: ScopeEntry;
  parent: Scope;
}

function scope_new(parent: Scope) -> Scope {
  return Scope {
    locals: null,
    parent: parent
  };
}

function scope_define(scope: Scope, name: str, type: str) -> void {
  let entry: ScopeEntry = ScopeEntry {
    name: name,
    type: type,
    next: scope.locals
  };
  scope.locals = entry;
}

function scope_resolve(scope: Scope, name: str) -> str {
  let curr_scope: Scope = scope;
  while (curr_scope != null) {
    let curr_entry: ScopeEntry = curr_scope.locals;
    while (curr_entry != null) {
      if (curr_entry.name == name) {
        return curr_entry.type;
      }
      curr_entry = curr_entry.next;
    }
    curr_scope = curr_scope.parent;
  }
  return null;
}

// ── Struct Layout tracking ──────────────────────────────────

struct StructFieldEntry {
  name: str;
  type: str;
  index: i32;
  next: StructFieldEntry;
}

struct StructLayoutEntry {
  name: str;
  llvm_type: str;
  fields: StructFieldEntry;
  next: StructLayoutEntry;
}

struct FuncReturnEntry {
  name: str;
  llvm_return: str;
  next: FuncReturnEntry;
}

// ── Output buffer tracking ──────────────────────────────────

struct OutputBuffer {
  line: str;
  next: OutputBuffer;
}

// ── LLVMEmitter State ───────────────────────────────────────

struct LLVMEmitter {
  out_head: OutputBuffer;
  out_tail: OutputBuffer;
  trampolines: OutputBuffer;
  global_strings: OutputBuffer;
  
  temp_count: i32;
  block_count: i32;
  string_count: i32;
  
  struct_layouts: StructLayoutEntry;
  function_returns: FuncReturnEntry;
  
  current_scope: Scope;
  target_triple: str;
}

function llvm_emitter_new(target_triple: str) -> LLVMEmitter {
  let global_scope: Scope = scope_new(null);
  
  // Register builtin types
  scope_define(global_scope, "print", "void");
  scope_define(global_scope, "readFile", "%str");
  scope_define(global_scope, "writeFile", "void");
  scope_define(global_scope, "str_length", "i32");
  
  return LLVMEmitter {
    out_head: null,
    out_tail: null,
    trampolines: null,
    global_strings: null,
    temp_count: 0,
    block_count: 0,
    string_count: 0,
    struct_layouts: null,
    function_returns: null,
    current_scope: global_scope,
    target_triple: target_triple
  };
}

function emit_line(emitter: LLVMEmitter, line: str) -> void {
  let buf: OutputBuffer = OutputBuffer { line: line, next: null };
  if (emitter.out_head == null) {
    emitter.out_head = buf;
    emitter.out_tail = buf;
  } else {
    emitter.out_tail.next = buf;
    emitter.out_tail = buf;
  }
}

function next_temp(emitter: LLVMEmitter) -> str {
  let t: i32 = emitter.temp_count;
  emitter.temp_count = t + 1;
  return "%t" + toString(t);
}

function next_block(emitter: LLVMEmitter) -> str {
  let b: i32 = emitter.block_count;
  emitter.block_count = b + 1;
  return "b" + toString(b);
}

function set_function_return(emitter: LLVMEmitter, name: str, ret_type: str) -> void {
  let entry: FuncReturnEntry = FuncReturnEntry {
    name: name,
    llvm_return: ret_type,
    next: emitter.function_returns
  };
  emitter.function_returns = entry;
}

function get_function_return(emitter: LLVMEmitter, name: str) -> str {
  let curr: FuncReturnEntry = emitter.function_returns;
  while (curr != null) {
    if (curr.name == name) { return curr.llvm_return; }
    curr = curr.next;
  }
  return "void";
}

function add_struct_layout(emitter: LLVMEmitter, name: str, llvm_type: str) -> StructLayoutEntry {
  let entry: StructLayoutEntry = StructLayoutEntry {
    name: name,
    llvm_type: llvm_type,
    fields: null,
    next: emitter.struct_layouts
  };
  emitter.struct_layouts = entry;
  return entry;
}

function get_struct_layout(emitter: LLVMEmitter, name: str) -> StructLayoutEntry {
  let curr: StructLayoutEntry = emitter.struct_layouts;
  while (curr != null) {
    if (curr.name == name) { return curr; }
    curr = curr.next;
  }
  return null;
}

function add_struct_field(layout: StructLayoutEntry, name: str, type: str, index: i32) -> void {
  let field: StructFieldEntry = StructFieldEntry {
    name: name,
    type: type,
    index: index,
    next: null
  };
  // Append to end to preserve index order conceptually, though index is stored
  if (layout.fields == null) {
    layout.fields = field;
  } else {
    let curr: StructFieldEntry = layout.fields;
    while (curr.next != null) {
      curr = curr.next;
    }
    curr.next = field;
  }
}

function get_struct_field(layout: StructLayoutEntry, name: str) -> StructFieldEntry {
  let curr: StructFieldEntry = layout.fields;
  while (curr != null) {
    if (curr.name == name) { return curr; }
    curr = curr.next;
  }
  return null;
}

function push_scope(emitter: LLVMEmitter) -> void {
  let new_scope: Scope = scope_new(emitter.current_scope);
  emitter.current_scope = new_scope;
}

function pop_scope(emitter: LLVMEmitter) -> void {
  if (emitter.current_scope != null) {
    emitter.current_scope = emitter.current_scope.parent;
  }
}

function emit_global_string(emitter: LLVMEmitter, str_val: str) -> str {
  let id: i32 = emitter.string_count;
  emitter.string_count = id + 1;
  let global_name: str = "@.str." + toString(id);
  
  let len: i32 = str_length(str_val) + 1;
  let def: str = global_name + " = private unnamed_addr constant [" + toString(len) + " x i8] c\"" + str_val + "\\00\", align 1";
  
  let buf: OutputBuffer = OutputBuffer { line: def, next: emitter.global_strings };
  emitter.global_strings = buf;
  
  return global_name;
}

function lookup_struct_name(type_str: str) -> str {
  let len: i32 = str_length(type_str);
  let res: str = type_str;
  if (charAt(type_str, 0) == "%") {
    res = substring(type_str, 1, len);
    len = len - 1;
  }
  if (charAt(res, len - 1) == "*") {
    res = substring(res, 0, len - 1);
  }
  return res;
}

function resolve_field(emitter: LLVMEmitter, struct_name: str, field_name: str) -> StructFieldEntry {
  let layout: StructLayoutEntry = get_struct_layout(emitter, struct_name);
  if (layout == null) { return null; }
  return get_struct_field(layout, field_name);
}

// ── Expressions ─────────────────────────────────────────────

struct EmitResult {
  reg: str;
  type: str;
}

function emit_lvalue(emitter: LLVMEmitter, expr: ASTNode) -> EmitResult {
  if (expr.kind == "Identifier") {
    let var_name: str = expr.name;
    let llvm_type: str = scope_resolve(emitter.current_scope, var_name);
    if (llvm_type == null) { llvm_type = "i32"; }
    return EmitResult { reg: "%" + var_name, type: llvm_type + "*" };
  }
  
  if (expr.kind == "UnaryExpr") {
    if (expr.op == "*") {
      return emit_expr(emitter, expr.right, null); // Evaluates to a pointer
    }
  }

  if (expr.kind == "FieldAccessExpr") {
    let lval: EmitResult = emit_lvalue(emitter, expr.object);
    let struct_name: str = lookup_struct_name(lval.type);
    let field: StructFieldEntry = resolve_field(emitter, struct_name, expr.property);
    if (field == null) { return EmitResult { reg: "0", type: "i32*" }; }
    
    let field_ptr: str = next_temp(emitter);
    emit_line(emitter, "  " + field_ptr + " = getelementptr inbounds %" + struct_name + ", %" + struct_name + "* " + lval.reg + ", i32 0, i32 " + toString(field.index));
    return EmitResult { reg: field_ptr, type: field.type + "*" };
  }

  if (expr.kind == "IndexAccessExpr") {
    let lval: EmitResult = emit_lvalue(emitter, expr.object);
    let struct_name: str = lookup_struct_name(lval.type);
    let elem_type: str = substring(struct_name, 6, str_length(struct_name)); // remove "array_"
    
    if (elem_type != "i8" and elem_type != "i16" and elem_type != "i32" and elem_type != "i64" and elem_type != "float" and elem_type != "double" and elem_type != "i1") {
      elem_type = "%" + elem_type;
    }

    let data_ptr_ptr: str = next_temp(emitter);
    emit_line(emitter, "  " + data_ptr_ptr + " = getelementptr inbounds %" + struct_name + ", %" + struct_name + "* " + lval.reg + ", i32 0, i32 2");
    
    let data_ptr: str = next_temp(emitter);
    emit_line(emitter, "  " + data_ptr + " = load " + elem_type + "*, " + elem_type + "** " + data_ptr_ptr);
    
    let index_expr: EmitResult = emit_expr(emitter, expr.right, null);
    let elem_ptr: str = next_temp(emitter);
    emit_line(emitter, "  " + elem_ptr + " = getelementptr inbounds " + elem_type + ", " + elem_type + "* " + data_ptr + ", i32 " + index_expr.reg);
    
    return EmitResult { reg: elem_ptr, type: elem_type + "*" };
  }
  
  emit_line(emitter, "  ; TODO: Invalid L-value expr: " + expr.kind);
  return EmitResult { reg: "0", type: "i32*" };
}

// Stub for now
function emit_expr(emitter: LLVMEmitter, expr: ASTNode, expected_type: str) -> EmitResult {
  if (expr == null) { return EmitResult { reg: "0", type: "i32" }; }
  
  if (expr.kind == "IntegerLiteral") {
    return EmitResult { reg: toString(expr.int_val), type: "i32" };
  }
  if (expr.kind == "FloatLiteral") {
    return EmitResult { reg: toString(expr.float_val), type: "double" };
  }
  if (expr.kind == "BooleanLiteral") {
    if (expr.bool_val) { return EmitResult { reg: "1", type: "i1" }; }
    else { return EmitResult { reg: "0", type: "i1" }; }
  }
  if (expr.kind == "NullLiteral") {
    return EmitResult { reg: "null", type: "i8*" };
  }
  
  if (expr.kind == "StringLiteral") {
    let val: str = expr.str_val;
    let global_name: str = emit_global_string(emitter, val);
    let len: i32 = str_length(val);
    let escaped_len: i32 = len + 1;
    
    let reg: str = next_temp(emitter);
    emit_line(emitter, "  " + reg + " = alloca %str");
    
    let ptr_ptr: str = next_temp(emitter);
    emit_line(emitter, "  " + ptr_ptr + " = getelementptr inbounds %str, %str* " + reg + ", i32 0, i32 0");
    let global_ptr: str = next_temp(emitter);
    emit_line(emitter, "  " + global_ptr + " = getelementptr inbounds [" + toString(escaped_len) + " x i8], [" + toString(escaped_len) + " x i8]* " + global_name + ", i32 0, i32 0");
    emit_line(emitter, "  store i8* " + global_ptr + ", i8** " + ptr_ptr);
    
    let len_ptr: str = next_temp(emitter);
    emit_line(emitter, "  " + len_ptr + " = getelementptr inbounds %str, %str* " + reg + ", i32 0, i32 1");
    emit_line(emitter, "  store i64 " + toString(len) + ", i64* " + len_ptr);
    
    let loaded: str = next_temp(emitter);
    emit_line(emitter, "  " + loaded + " = load %str, %str* " + reg);
    return EmitResult { reg: loaded, type: "%str" };
  }

  if (expr.kind == "ArrayLiteral") {
    let array_type: str = expected_type;
    if (array_type == null and expr.elements != null) {
       let first: EmitResult = emit_expr(emitter, expr.elements, null);
       array_type = "%array_" + first.type;
    }
    
    let struct_name: str = lookup_struct_name(array_type);
    let elem_type: str = substring(struct_name, 6, str_length(struct_name));
    if (elem_type != "i8" and elem_type != "i16" and elem_type != "i32" and elem_type != "i64" and elem_type != "float" and elem_type != "double" and elem_type != "i1") {
      elem_type = "%" + elem_type;
    }
    
    let elem_count: i32 = 0;
    let curr_el: ASTNode = expr.elements;
    while (curr_el != null) { elem_count = elem_count + 1; curr_el = curr_el.next; }
    
    let reg: str = next_temp(emitter);
    emit_line(emitter, "  " + reg + " = alloca %" + struct_name);
    
    let initial_cap: i32 = 8;
    if (elem_count > 8) { initial_cap = elem_count; }
    let elem_size: i32 = llvm_type_size(elem_type);
    let bytes: i32 = initial_cap * elem_size;
    
    let raw_data: str = next_temp(emitter);
    emit_line(emitter, "  " + raw_data + " = call i8* @malloc(i64 " + toString(bytes) + ")");
    let typed_data: str = next_temp(emitter);
    emit_line(emitter, "  " + typed_data + " = bitcast i8* " + raw_data + " to " + elem_type + "*");
    
    let len_ptr: str = next_temp(emitter);
    emit_line(emitter, "  " + len_ptr + " = getelementptr inbounds %" + struct_name + ", %" + struct_name + "* " + reg + ", i32 0, i32 0");
    emit_line(emitter, "  store i32 " + toString(elem_count) + ", i32* " + len_ptr);
    
    let cap_ptr: str = next_temp(emitter);
    emit_line(emitter, "  " + cap_ptr + " = getelementptr inbounds %" + struct_name + ", %" + struct_name + "* " + reg + ", i32 0, i32 1");
    emit_line(emitter, "  store i32 " + toString(initial_cap) + ", i32* " + cap_ptr);
    
    let data_ptr: str = next_temp(emitter);
    emit_line(emitter, "  " + data_ptr + " = getelementptr inbounds %" + struct_name + ", %" + struct_name + "* " + reg + ", i32 0, i32 2");
    emit_line(emitter, "  store " + elem_type + "* " + typed_data + ", " + elem_type + "** " + data_ptr);
    
    let i: i32 = 0;
    curr_el = expr.elements;
    while (curr_el != null) {
      let val: EmitResult = emit_expr(emitter, curr_el, elem_type);
      let elem_ptr: str = next_temp(emitter);
      emit_line(emitter, "  " + elem_ptr + " = getelementptr inbounds " + elem_type + ", " + elem_type + "* " + typed_data + ", i32 " + toString(i));
      emit_line(emitter, "  store " + elem_type + " " + val.reg + ", " + elem_type + "* " + elem_ptr);
      i = i + 1;
      curr_el = curr_el.next;
    }
    
    let val_reg: str = next_temp(emitter);
    emit_line(emitter, "  " + val_reg + " = load %" + struct_name + ", %" + struct_name + "* " + reg);
    return EmitResult { reg: val_reg, type: "%" + struct_name };
  }

  if (expr.kind == "StructLiteral") {
    let struct_name: str = expr.name;
    let reg: str = next_temp(emitter);
    emit_line(emitter, "  " + reg + " = alloca %" + struct_name);
    
    let curr_f: ASTNode = expr.fields;
    while (curr_f != null) {
      let field_name: str = curr_f.name;
      let field_entry: StructFieldEntry = resolve_field(emitter, struct_name, field_name);
      
      let field_ptr: str = next_temp(emitter);
      emit_line(emitter, "  " + field_ptr + " = getelementptr inbounds %" + struct_name + ", %" + struct_name + "* " + reg + ", i32 0, i32 " + toString(field_entry.index));
      let val: EmitResult = emit_expr(emitter, curr_f.right, null);
      emit_line(emitter, "  store " + field_entry.type + " " + val.reg + ", " + field_entry.type + "* " + field_ptr);
      
      curr_f = curr_f.next;
    }
    
    let val_reg: str = next_temp(emitter);
    emit_line(emitter, "  " + val_reg + " = load %" + struct_name + ", %" + struct_name + "* " + reg);
    return EmitResult { reg: val_reg, type: "%" + struct_name };
  }

  if (expr.kind == "Identifier" or expr.kind == "FieldAccessExpr" or expr.kind == "IndexAccessExpr") {
    let lval: EmitResult = emit_lvalue(emitter, expr);
    let val_type: str = substring(lval.type, 0, str_length(lval.type) - 1);
    let reg: str = next_temp(emitter);
    emit_line(emitter, "  " + reg + " = load " + val_type + ", " + lval.type + " " + lval.reg);
    return EmitResult { reg: reg, type: val_type };
  }
  
  if (expr.kind == "BinaryExpr") {
    let left: EmitResult = emit_expr(emitter, expr.left, null);
    let right: EmitResult = emit_expr(emitter, expr.right, null);
    let reg: str = next_temp(emitter);
    let op: str = expr.op;
    let is_float: bool = (left.type == "float" or left.type == "double");
    let llvm_op: str = "add";
    
    if (op == "+") { if (is_float) { llvm_op = "fadd"; } else { llvm_op = "add"; } }
    else if (op == "-") { if (is_float) { llvm_op = "fsub"; } else { llvm_op = "sub"; } }
    else if (op == "*") { if (is_float) { llvm_op = "fmul"; } else { llvm_op = "mul"; } }
    else if (op == "/") { if (is_float) { llvm_op = "fdiv"; } else { llvm_op = "sdiv"; } }
    else if (op == "==") { if (is_float) { llvm_op = "fcmp oeq"; } else { llvm_op = "icmp eq"; } }
    else if (op == "!=") { if (is_float) { llvm_op = "fcmp one"; } else { llvm_op = "icmp ne"; } }
    else if (op == "<") { if (is_float) { llvm_op = "fcmp olt"; } else { llvm_op = "icmp slt"; } }
    else if (op == ">") { if (is_float) { llvm_op = "fcmp ogt"; } else { llvm_op = "icmp sgt"; } }
    else if (op == "<=") { if (is_float) { llvm_op = "fcmp ole"; } else { llvm_op = "icmp sle"; } }
    else if (op == ">=") { if (is_float) { llvm_op = "fcmp oge"; } else { llvm_op = "icmp sge"; } }
    
    emit_line(emitter, "  " + reg + " = " + llvm_op + " " + left.type + " " + left.reg + ", " + right.reg);
    
    if (op == "==" or op == "!=" or op == "<" or op == ">" or op == "<=" or op == ">=") {
      return EmitResult { reg: reg, type: "i1" };
    }
    return EmitResult { reg: reg, type: left.type };
  }
  
  if (expr.kind == "AssignmentExpr") {
    let val_res: EmitResult = emit_expr(emitter, expr.right, null);
    let lval: EmitResult = emit_lvalue(emitter, expr.left);
    emit_line(emitter, "  store " + val_res.type + " " + val_res.reg + ", " + lval.type + " " + lval.reg);
    return val_res;
  }
  
  if (expr.kind == "PostfixExpr") {
    let lval: EmitResult = emit_lvalue(emitter, expr.left);
    // Since we don't have substring, we look up the var again or assume i32 for simplicity unless we can resolve it
    let val_type: str = "i32";
    if (expr.left.kind == "Identifier") {
      val_type = scope_resolve(emitter.current_scope, expr.left.name);
      if (val_type == null) { val_type = "i32"; }
    } else {
      // It might be a deref pointer, we'll assume i32 for now in the self-host unless we add a string_slice
      emit_line(emitter, "  ; TODO: accurate type for complex Postfix lval");
    }
    
    let is_float: bool = (val_type == "float" or val_type == "double");
    let op: str = expr.op;
    
    let old_reg: str = next_temp(emitter);
    emit_line(emitter, "  " + old_reg + " = load " + val_type + ", " + lval.type + " " + lval.reg);
    
    let one_reg: str = "1";
    if (is_float) { one_reg = "1.0"; }
    let new_reg: str = next_temp(emitter);
    
    if (op == "++") {
      if (is_float) { emit_line(emitter, "  " + new_reg + " = fadd " + val_type + " " + old_reg + ", " + one_reg); }
      else { emit_line(emitter, "  " + new_reg + " = add " + val_type + " " + old_reg + ", " + one_reg); }
    } else {
      if (is_float) { emit_line(emitter, "  " + new_reg + " = fsub " + val_type + " " + old_reg + ", " + one_reg); }
      else { emit_line(emitter, "  " + new_reg + " = sub " + val_type + " " + old_reg + ", " + one_reg); }
    }
    
    emit_line(emitter, "  store " + val_type + " " + new_reg + ", " + lval.type + " " + lval.reg);
    return EmitResult { reg: old_reg, type: val_type };
  }
  
  if (expr.kind == "UnaryExpr") {
    let op: str = expr.op;
    if (op == "&") {
      if (expr.right.kind == "Identifier") {
        let var_name: str = expr.right.name;
        let llvm_type: str = scope_resolve(emitter.current_scope, var_name);
        if (llvm_type == null) { llvm_type = "i32"; }
        return EmitResult { reg: "%" + var_name, type: llvm_type + "*" };
      } else {
        emit_line(emitter, "  ; TODO: Address-Of requires identifier");
        return EmitResult { reg: "null", type: "i8*" };
      }
    } else if (op == "*") {
      let ptr_res: EmitResult = emit_expr(emitter, expr.right, null);
      // Strip *
      let val_type: str = "i32"; // Simplified
      if (expr.right.kind == "Identifier") {
         let resolved: str = scope_resolve(emitter.current_scope, expr.right.name);
         if (resolved != null) {
           // Wait, ptr_res.type is what we want to strip
           emit_line(emitter, "  ; TODO: accurate pointer deref type string stripping");
         }
      }
      let reg: str = next_temp(emitter);
      emit_line(emitter, "  " + reg + " = load " + val_type + ", " + ptr_res.type + " " + ptr_res.reg);
      return EmitResult { reg: reg, type: val_type };
    } else if (op == "!" or op == "-") {
      let res: EmitResult = emit_expr(emitter, expr.right, null);
      let new_reg: str = next_temp(emitter);
      if (op == "!") {
        emit_line(emitter, "  " + new_reg + " = xor i1 " + res.reg + ", 1");
        return EmitResult { reg: new_reg, type: "i1" };
      } else {
        let is_float: bool = (res.type == "float" or res.type == "double");
        if (is_float) { emit_line(emitter, "  " + new_reg + " = fneg " + res.type + " " + res.reg); }
        else { emit_line(emitter, "  " + new_reg + " = sub " + res.type + " 0, " + res.reg); }
        return EmitResult { reg: new_reg, type: res.type };
      }
    }
  }
  
  if (expr.kind == "AllocExpr") {
    let size_res: EmitResult = emit_expr(emitter, expr.left, null);
    let arg_reg: str = size_res.reg;
    
    if (size_res.type == "i32") {
      arg_reg = next_temp(emitter);
      emit_line(emitter, "  " + arg_reg + " = zext i32 " + size_res.reg + " to i64");
    }
    
    let reg: str = next_temp(emitter);
    emit_line(emitter, "  " + reg + " = call i8* @malloc(i64 " + arg_reg + ")");
    return EmitResult { reg: reg, type: "i8*" };
  }
  
  if (expr.kind == "CallExpr") {
    let callee_name: str = "unknown";
    if (expr.callee != null and expr.callee.kind == "Identifier") {
      callee_name = expr.callee.name;
    }
    
    let arg0: ASTNode = expr.args;
    let arg1: ASTNode = null;
    let arg2: ASTNode = null;
    if (arg0 != null) { arg1 = arg0.next; }
    if (arg1 != null) { arg2 = arg1.next; }

    if (callee_name == "free") {
      let arg: EmitResult = emit_expr(emitter, arg0, null);
      let ptr_reg: str = arg.reg;
      if (arg.type != "i8*") {
        ptr_reg = next_temp(emitter);
        emit_line(emitter, "  " + ptr_reg + " = bitcast " + arg.type + " " + arg.reg + " to i8*");
      }
      emit_line(emitter, "  call void @free(i8* " + ptr_reg + ")");
      return EmitResult { reg: "0", type: "void" };
    }
    if (callee_name == "panic") {
      let arg: EmitResult = emit_expr(emitter, arg0, null);
      let ptr_reg: str = arg.reg;
      if (arg.type == "%str") {
        ptr_reg = next_temp(emitter);
        emit_line(emitter, "  " + ptr_reg + " = extractvalue %str " + arg.reg + ", 0");
      }
      emit_line(emitter, "  call void @vks_panic(i8* " + ptr_reg + ")");
      emit_line(emitter, "  unreachable");
      return EmitResult { reg: "0", type: "void" };
    }
    if (callee_name == "print") {
      let arg: EmitResult = emit_expr(emitter, arg0, null);
      if (arg.type == "i32") {
        emit_line(emitter, "  call void @vks_print_i32(i32 " + arg.reg + ")");
      } else if (arg.type == "double") {
        emit_line(emitter, "  call void @vks_print_f64(double " + arg.reg + ")");
      } else if (arg.type == "i1") {
        let zext: str = next_temp(emitter);
        emit_line(emitter, "  " + zext + " = zext i1 " + arg.reg + " to i32");
        emit_line(emitter, "  call void @vks_print_bool(i32 " + zext + ")");
      } else if (arg.type == "%str") {
        let reg_ptr: str = next_temp(emitter);
        emit_line(emitter, "  " + reg_ptr + " = extractvalue %str " + arg.reg + ", 0");
        let reg_len: str = next_temp(emitter);
        emit_line(emitter, "  " + reg_len + " = extractvalue %str " + arg.reg + ", 1");
        emit_line(emitter, "  call void @vks_print_str(i8* " + reg_ptr + ", i64 " + reg_len + ")");
      } else {
        emit_line(emitter, "  ; TODO: print for type " + arg.type);
      }
      return EmitResult { reg: "0", type: "void" };
    }
    if (callee_name == "array_length") {
      let arr: EmitResult = emit_expr(emitter, arg0, null);
      let struct_name: str = lookup_struct_name(arr.type);
      let len_reg: str = next_temp(emitter);
      emit_line(emitter, "  " + len_reg + " = extractvalue %" + struct_name + " " + arr.reg + ", 0");
      return EmitResult { reg: len_reg, type: "i32" };
    }
    if (callee_name == "array_push") {
      let arr: EmitResult = emit_lvalue(emitter, arg0);
      let val: EmitResult = emit_expr(emitter, arg1, null);
      let struct_name: str = lookup_struct_name(arr.type);
      let elem_type: str = val.type;
      
      let len_ptr: str = next_temp(emitter);
      emit_line(emitter, "  " + len_ptr + " = getelementptr inbounds %" + struct_name + ", %" + struct_name + "* " + arr.reg + ", i32 0, i32 0");
      let len: str = next_temp(emitter);
      emit_line(emitter, "  " + len + " = load i32, i32* " + len_ptr);
      
      let cap_ptr: str = next_temp(emitter);
      emit_line(emitter, "  " + cap_ptr + " = getelementptr inbounds %" + struct_name + ", %" + struct_name + "* " + arr.reg + ", i32 0, i32 1");
      let cap: str = next_temp(emitter);
      emit_line(emitter, "  " + cap + " = load i32, i32* " + cap_ptr);
      
      let cond: str = next_temp(emitter);
      emit_line(emitter, "  " + cond + " = icmp eq i32 " + len + ", " + cap);
      
      let resize_block: str = next_block(emitter);
      let push_block: str = next_block(emitter);
      
      emit_line(emitter, "  br i1 " + cond + ", label %" + resize_block + ", label %" + push_block);
      
      emit_line(emitter, resize_block + ":");
      let new_cap: str = next_temp(emitter);
      emit_line(emitter, "  " + new_cap + " = mul i32 " + cap + ", 2");
      let elem_size: i32 = llvm_type_size(elem_type);
      let new_bytes: str = next_temp(emitter);
      emit_line(emitter, "  " + new_bytes + " = mul i32 " + new_cap + ", " + toString(elem_size));
      let new_bytes_64: str = next_temp(emitter);
      emit_line(emitter, "  " + new_bytes_64 + " = zext i32 " + new_bytes + " to i64");
      
      let new_data: str = next_temp(emitter);
      emit_line(emitter, "  " + new_data + " = call i8* @malloc(i64 " + new_bytes_64 + ")");
      
      let data_ptr: str = next_temp(emitter);
      emit_line(emitter, "  " + data_ptr + " = getelementptr inbounds %" + struct_name + ", %" + struct_name + "* " + arr.reg + ", i32 0, i32 2");
      let old_data: str = next_temp(emitter);
      emit_line(emitter, "  " + old_data + " = load " + elem_type + "*, " + elem_type + "** " + data_ptr);
      let old_data_i8: str = next_temp(emitter);
      emit_line(emitter, "  " + old_data_i8 + " = bitcast " + elem_type + "* " + old_data + " to i8*");
      
      let old_bytes: str = next_temp(emitter);
      emit_line(emitter, "  " + old_bytes + " = mul i32 " + len + ", " + toString(elem_size));
      let old_bytes_64: str = next_temp(emitter);
      emit_line(emitter, "  " + old_bytes_64 + " = zext i32 " + old_bytes + " to i64");
      
      emit_line(emitter, "  call void @llvm.memcpy.p0i8.p0i8.i64(i8* align 1 " + new_data + ", i8* align 1 " + old_data_i8 + ", i64 " + old_bytes_64 + ", i1 false)");
      emit_line(emitter, "  call void @free(i8* " + old_data_i8 + ")");
      
      let new_data_typed: str = next_temp(emitter);
      emit_line(emitter, "  " + new_data_typed + " = bitcast i8* " + new_data + " to " + elem_type + "*");
      emit_line(emitter, "  store " + elem_type + "* " + new_data_typed + ", " + elem_type + "** " + data_ptr);
      emit_line(emitter, "  store i32 " + new_cap + ", i32* " + cap_ptr);
      emit_line(emitter, "  br label %" + push_block);
      
      emit_line(emitter, push_block + ":");
      let curr_data_ptr: str = next_temp(emitter);
      emit_line(emitter, "  " + curr_data_ptr + " = getelementptr inbounds %" + struct_name + ", %" + struct_name + "* " + arr.reg + ", i32 0, i32 2");
      let curr_data: str = next_temp(emitter);
      emit_line(emitter, "  " + curr_data + " = load " + elem_type + "*, " + elem_type + "** " + curr_data_ptr);
      
      let target_ptr: str = next_temp(emitter);
      emit_line(emitter, "  " + target_ptr + " = getelementptr inbounds " + elem_type + ", " + elem_type + "* " + curr_data + ", i32 " + len);
      emit_line(emitter, "  store " + elem_type + " " + val.reg + ", " + elem_type + "* " + target_ptr);
      
      let new_len: str = next_temp(emitter);
      emit_line(emitter, "  " + new_len + " = add i32 " + len + ", 1");
      emit_line(emitter, "  store i32 " + new_len + ", i32* " + len_ptr);
      
      return EmitResult { reg: "0", type: "void" };
    }
    if (callee_name == "Ok" or callee_name == "Err") {
      let struct_name: str = lookup_struct_name(expected_type);
      let ok_type: str = resolve_field(emitter, struct_name, "value").type;
      let err_type: str = resolve_field(emitter, struct_name, "error").type;
      let is_ok: bool = (callee_name == "Ok");
      let arg: EmitResult = emit_expr(emitter, arg0, null);
      
      let reg: str = next_temp(emitter);
      emit_line(emitter, "  " + reg + " = alloca %" + struct_name);
      
      let is_ok_ptr: str = next_temp(emitter);
      emit_line(emitter, "  " + is_ok_ptr + " = getelementptr inbounds %" + struct_name + ", %" + struct_name + "* " + reg + ", i32 0, i32 0");
      if (is_ok) { emit_line(emitter, "  store i1 1, i1* " + is_ok_ptr); }
      else { emit_line(emitter, "  store i1 0, i1* " + is_ok_ptr); }
      
      let val_ptr: str = next_temp(emitter);
      if (is_ok) {
        emit_line(emitter, "  " + val_ptr + " = getelementptr inbounds %" + struct_name + ", %" + struct_name + "* " + reg + ", i32 0, i32 1");
        emit_line(emitter, "  store " + ok_type + " " + arg.reg + ", " + ok_type + "* " + val_ptr);
      } else {
        emit_line(emitter, "  " + val_ptr + " = getelementptr inbounds %" + struct_name + ", %" + struct_name + "* " + reg + ", i32 0, i32 2");
        emit_line(emitter, "  store " + err_type + " " + arg.reg + ", " + err_type + "* " + val_ptr);
      }
      
      let loaded: str = next_temp(emitter);
      emit_line(emitter, "  " + loaded + " = load %" + struct_name + ", %" + struct_name + "* " + reg);
      return EmitResult { reg: loaded, type: "%" + struct_name };
    }
    if (callee_name == "sqrt") {
      let arg: EmitResult = emit_expr(emitter, arg0, null);
      let reg: str = next_temp(emitter);
      emit_line(emitter, "  " + reg + " = call double @vks_sqrt(double " + arg.reg + ")");
      return EmitResult { reg: reg, type: "double" };
    }
    if (callee_name == "get_args") {
      let reg: str = next_temp(emitter);
      emit_line(emitter, "  " + reg + " = call %array_str @vks_get_args()");
      return EmitResult { reg: reg, type: "%array_str" };
    }
    if (callee_name == "get_env") {
      let arg: EmitResult = emit_expr(emitter, arg0, null);
      let reg: str = next_temp(emitter);
      emit_line(emitter, "  " + reg + " = call %str* @vks_get_env(" + arg.type + " " + arg.reg + ")");
      return EmitResult { reg: reg, type: "%str*" };
    }
    if (callee_name == "system") {
      let arg: EmitResult = emit_expr(emitter, arg0, null);
      let reg: str = next_temp(emitter);
      emit_line(emitter, "  " + reg + " = call i32 @vks_system(" + arg.type + " " + arg.reg + ")");
      return EmitResult { reg: reg, type: "i32" };
    }
    if (callee_name == "str_split") {
      let arg1: EmitResult = emit_expr(emitter, arg0, null);
      let arg2: EmitResult = emit_expr(emitter, arg0.next, null);
      
      let ptr1: str = next_temp(emitter);
      emit_line(emitter, "  " + ptr1 + " = extractvalue %str " + arg1.reg + ", 0");
      let len1: str = next_temp(emitter);
      emit_line(emitter, "  " + len1 + " = extractvalue %str " + arg1.reg + ", 1");
      
      let ptr2: str = next_temp(emitter);
      emit_line(emitter, "  " + ptr2 + " = extractvalue %str " + arg2.reg + ", 0");
      let len2: str = next_temp(emitter);
      emit_line(emitter, "  " + len2 + " = extractvalue %str " + arg2.reg + ", 1");
      
      let ptr_reg: str = next_temp(emitter);
      emit_line(emitter, "  " + ptr_reg + " = call %array_str* @vks_str_split(i8* " + ptr1 + ", i64 " + len1 + ", i8* " + ptr2 + ", i64 " + len2 + ")");
      
      let reg: str = next_temp(emitter);
      emit_line(emitter, "  " + reg + " = load %array_str, %array_str* " + ptr_reg);
      
      let ptr_i8: str = next_temp(emitter);
      emit_line(emitter, "  " + ptr_i8 + " = bitcast %array_str* " + ptr_reg + " to i8*");
      emit_line(emitter, "  call void @free(i8* " + ptr_i8 + ")");
      return EmitResult { reg: reg, type: "%array_str" };
    }
    if (callee_name == "str_replace") {
      let arg1: EmitResult = emit_expr(emitter, arg0, null);
      let arg2: EmitResult = emit_expr(emitter, arg0.next, null);
      let arg3: EmitResult = emit_expr(emitter, arg0.next.next, null);
      let reg: str = next_temp(emitter);
      emit_line(emitter, "  " + reg + " = call %str @vks_str_replace(" + arg1.type + " " + arg1.reg + ", " + arg2.type + " " + arg2.reg + ", " + arg3.type + " " + arg3.reg + ")");
      return EmitResult { reg: reg, type: "%str" };
    }
    if (callee_name == "free_str_array") {
      let arg: EmitResult = emit_expr(emitter, arg0, null);
      emit_line(emitter, "  call void @vks_free_str_array(" + arg.type + " " + arg.reg + ")");
      return EmitResult { reg: "0", type: "void" };
    }
    if (callee_name == "tcp_connect") {
      let arg1: EmitResult = emit_expr(emitter, arg0, null);
      let arg2: EmitResult = emit_expr(emitter, arg0.next, null);
      
      let ptr_reg: str = next_temp(emitter);
      emit_line(emitter, "  " + ptr_reg + " = extractvalue %str " + arg1.reg + ", 0");
      let len_reg: str = next_temp(emitter);
      emit_line(emitter, "  " + len_reg + " = extractvalue %str " + arg1.reg + ", 1");
      
      let reg: str = next_temp(emitter);
      emit_line(emitter, "  " + reg + " = call i8* @vks_tcp_connect(i8* " + ptr_reg + ", i64 " + len_reg + ", " + arg2.type + " " + arg2.reg + ")");
      return EmitResult { reg: reg, type: "i8*" };
    }
    if (callee_name == "socket_send") {
      let arg1: EmitResult = emit_expr(emitter, arg0, null);
      let arg2: EmitResult = emit_expr(emitter, arg0.next, null);
      
      let ptr_reg: str = next_temp(emitter);
      emit_line(emitter, "  " + ptr_reg + " = extractvalue %str " + arg2.reg + ", 0");
      let len_reg: str = next_temp(emitter);
      emit_line(emitter, "  " + len_reg + " = extractvalue %str " + arg2.reg + ", 1");
      
      let reg: str = next_temp(emitter);
      emit_line(emitter, "  " + reg + " = call i32 @vks_socket_send(" + arg1.type + " " + arg1.reg + ", i8* " + ptr_reg + ", i64 " + len_reg + ")");
      return EmitResult { reg: reg, type: "i32" };
    }
    if (callee_name == "socket_recv") {
      let arg1: EmitResult = emit_expr(emitter, arg0, null);
      let ptr_val: str = next_temp(emitter);
      emit_line(emitter, "  " + ptr_val + " = call %str* @vks_socket_recv_all(" + arg1.type + " " + arg1.reg + ")");
      let reg: str = next_temp(emitter);
      emit_line(emitter, "  " + reg + " = load %str, %str* " + ptr_val);
      let ptr_i8: str = next_temp(emitter);
      emit_line(emitter, "  " + ptr_i8 + " = bitcast %str* " + ptr_val + " to i8*");
      emit_line(emitter, "  call void @free(i8* " + ptr_i8 + ")");
      return EmitResult { reg: reg, type: "%str" };
    }
    if (callee_name == "socket_close") {
      let arg1: EmitResult = emit_expr(emitter, arg0, null);
      emit_line(emitter, "  call void @vks_socket_close(" + arg1.type + " " + arg1.reg + ")");
      return EmitResult { reg: "0", type: "void" };
    }
    if (callee_name == "thread_join") {
      let arg1: EmitResult = emit_expr(emitter, arg0, null);
      emit_line(emitter, "  call void @vks_thread_join(i8* " + arg1.reg + ")");
      return EmitResult { reg: "0", type: "void" };
    }
    if (callee_name == "mutex_create") {
      let m: str = next_temp(emitter);
      emit_line(emitter, "  " + m + " = call i8* @vks_mutex_create()");
      return EmitResult { reg: m, type: "i8*" };
    }
    if (callee_name == "mutex_lock") {
      let arg1: EmitResult = emit_expr(emitter, arg0, null);
      emit_line(emitter, "  call void @vks_mutex_lock(i8* " + arg1.reg + ")");
      return EmitResult { reg: "0", type: "void" };
    }
    if (callee_name == "mutex_unlock") {
      let arg1: EmitResult = emit_expr(emitter, arg0, null);
      emit_line(emitter, "  call void @vks_mutex_unlock(i8* " + arg1.reg + ")");
      return EmitResult { reg: "0", type: "void" };
    }
    if (callee_name == "mutex_destroy") {
      let arg1: EmitResult = emit_expr(emitter, arg0, null);
      emit_line(emitter, "  call void @vks_mutex_destroy(i8* " + arg1.reg + ")");
      return EmitResult { reg: "0", type: "void" };
    }
    
    // Evaluate arguments for standard call
    let args_str: str = "";
    let curr_arg: ASTNode = expr.args;
    while (curr_arg != null) {
      let arg_res: EmitResult = emit_expr(emitter, curr_arg, null);
      if (args_str != "") { args_str = args_str + ", "; }
      args_str = args_str + arg_res.type + " " + arg_res.reg;
      curr_arg = curr_arg.next;
    }
    
    let ret_type: str = get_function_return(emitter, callee_name);
    let reg: str = next_temp(emitter);
    
    if (ret_type == "void") {
      emit_line(emitter, "  call " + ret_type + " @" + callee_name + "(" + args_str + ")");
      return EmitResult { reg: "0", type: "void" };
    } else {
      emit_line(emitter, "  " + reg + " = call " + ret_type + " @" + callee_name + "(" + args_str + ")");
      return EmitResult { reg: reg, type: ret_type };
    }
  }
  
  if (expr.kind == "SpawnExpr") {
    emit_line(emitter, "  ; TODO: SpawnExpr in self-hosted");
    return EmitResult { reg: "0", type: "i32" };
  }

  emit_line(emitter, "  ; TODO: unhandled expr kind " + expr.kind);
  return EmitResult { reg: "0", type: "i32" };
}

// ── Statements ──────────────────────────────────────────────

function emit_stmt(emitter: LLVMEmitter, stmt: ASTNode) -> void {
  if (stmt == null) { return; }

  if (stmt.kind == "ReturnStatement") {
    emit_line(emitter, "  call void @vks_pop_frame()");
    if (stmt.left == null) {
      emit_line(emitter, "  ret void");
      return;
    }
    let res: EmitResult = emit_expr(emitter, stmt.left, null);
    emit_line(emitter, "  ret " + res.type + " " + res.reg);
    return;
  }

  if (stmt.kind == "LetStatement" or stmt.kind == "ConstStatement") {
    let llvm_type: str = vks_type_to_llvm(stmt.returnType);
    scope_define(emitter.current_scope, stmt.name, llvm_type);

    emit_line(emitter, "  %" + stmt.name + " = alloca " + llvm_type);
    if (stmt.initializer != null) {
      let res: EmitResult = emit_expr(emitter, stmt.initializer, llvm_type);
      emit_line(emitter, "  store " + res.type + " " + res.reg + ", " + llvm_type + "* %" + stmt.name);
    }
    return;
  }

  if (stmt.kind == "IfStatement") {
    let cond: EmitResult = emit_expr(emitter, stmt.condition, "i1");
    let then_label: str = next_block(emitter);
    let else_label: str = next_block(emitter);
    let end_label: str = next_block(emitter);

    emit_line(emitter, "  br i1 " + cond.reg + ", label %" + then_label + ", label %" + else_label);
    
    emit_line(emitter, then_label + ":");
    push_scope(emitter);
    if (stmt.body.kind == "Block") {
      let curr: ASTNode = stmt.body.body;
      while (curr != null) { emit_stmt(emitter, curr); curr = curr.next; }
    } else { emit_stmt(emitter, stmt.body); }
    pop_scope(emitter);
    emit_line(emitter, "  br label %" + end_label);

    emit_line(emitter, else_label + ":");
    if (stmt.else_body != null) {
      push_scope(emitter);
      if (stmt.else_body.kind == "Block") {
        let curr: ASTNode = stmt.else_body.body;
        while (curr != null) { emit_stmt(emitter, curr); curr = curr.next; }
      } else { emit_stmt(emitter, stmt.else_body); }
      pop_scope(emitter);
    }
    emit_line(emitter, "  br label %" + end_label);

    emit_line(emitter, end_label + ":");
    return;
  }

  if (stmt.kind == "WhileStatement") {
    let cond_label: str = next_block(emitter);
    let body_label: str = next_block(emitter);
    let end_label: str = next_block(emitter);

    emit_line(emitter, "  br label %" + cond_label);
    
    emit_line(emitter, cond_label + ":");
    let cond: EmitResult = emit_expr(emitter, stmt.condition, "i1");
    emit_line(emitter, "  br i1 " + cond.reg + ", label %" + body_label + ", label %" + end_label);

    emit_line(emitter, body_label + ":");
    push_scope(emitter);
    if (stmt.body.kind == "Block") {
      let curr: ASTNode = stmt.body.body;
      while (curr != null) { emit_stmt(emitter, curr); curr = curr.next; }
    } else { emit_stmt(emitter, stmt.body); }
    pop_scope(emitter);
    emit_line(emitter, "  br label %" + cond_label);

    emit_line(emitter, end_label + ":");
    return;
  }

  if (stmt.kind == "ForStatement") {
    push_scope(emitter);
    
    if (stmt.initializer != null) { emit_stmt(emitter, stmt.initializer); }
    
    let cond_label: str = next_block(emitter);
    let body_label: str = next_block(emitter);
    let end_label: str = next_block(emitter);

    emit_line(emitter, "  br label %" + cond_label);
    
    emit_line(emitter, cond_label + ":");
    if (stmt.condition != null) {
      let cond: EmitResult = emit_expr(emitter, stmt.condition, "i1");
      emit_line(emitter, "  br i1 " + cond.reg + ", label %" + body_label + ", label %" + end_label);
    } else {
      emit_line(emitter, "  br label %" + body_label);
    }

    emit_line(emitter, body_label + ":");
    if (stmt.body.kind == "Block") {
      let curr: ASTNode = stmt.body.body;
      while (curr != null) { emit_stmt(emitter, curr); curr = curr.next; }
    } else { emit_stmt(emitter, stmt.body); }
    
    if (stmt.increment != null) {
      emit_expr(emitter, stmt.increment, null);
    }
    
    emit_line(emitter, "  br label %" + cond_label);

    emit_line(emitter, end_label + ":");
    pop_scope(emitter);
    return;
  }

  if (stmt.kind == "ExpressionStatement") {
    emit_expr(emitter, stmt.left, null);
    return;
  }
}

// ── Top Level ───────────────────────────────────────────────

function emit_function(emitter: LLVMEmitter, func_node: ASTNode) -> void {
  push_scope(emitter);
  emitter.temp_count = 0;
  emitter.block_count = 0;

  let ret_type: str = "void";
  if (func_node.returnType != null) { ret_type = vks_type_to_llvm(func_node.returnType); }

  let params_str: str = "";
  let curr_param: ASTNode = func_node.params;
  while (curr_param != null) {
    let llvm_type: str = vks_type_to_llvm(curr_param.returnType);
    scope_define(emitter.current_scope, curr_param.name, llvm_type);
    
    if (params_str != "") { params_str = params_str + ", "; }
    params_str = params_str + llvm_type + " %" + curr_param.name + ".arg";
    curr_param = curr_param.next;
  }

  let actual_name: str = func_node.name;
  if (func_node.name == "main") { actual_name = "vks_main"; }

  emit_line(emitter, "define " + ret_type + " @" + actual_name + "(" + params_str + ") {");
  emit_line(emitter, "entry:");

  // For simplicity in batch 1, we omit the stack trace vks_push_frame logic since we don't have strings built yet.
  
  // Allocate stack slots for params
  curr_param = func_node.params;
  while (curr_param != null) {
    let llvm_type: str = vks_type_to_llvm(curr_param.returnType);
    emit_line(emitter, "  %" + curr_param.name + " = alloca " + llvm_type);
    emit_line(emitter, "  store " + llvm_type + " %" + curr_param.name + ".arg, " + llvm_type + "* %" + curr_param.name);
    curr_param = curr_param.next;
  }

  // Body
  if (func_node.body.kind == "Block") {
    let curr_stmt: ASTNode = func_node.body.body;
    while (curr_stmt != null) {
      emit_stmt(emitter, curr_stmt);
      curr_stmt = curr_stmt.next;
    }
  }

  // Safety net
  if (ret_type == "void") {
    emit_line(emitter, "  ret void");
  } else {
    emit_line(emitter, "  ret " + ret_type + " zeroinitializer");
  }

  emit_line(emitter, "}");
  emit_line(emitter, "");
  
  pop_scope(emitter);
}

function emit_program(program: ASTNode, target_triple: str) -> str {
  let emitter: LLVMEmitter = llvm_emitter_new(target_triple);
  
  // First pass: define struct types
  let curr_struct: ASTNode = program.right;
  while (curr_struct != null) {
    if (curr_struct.kind == "StructDecl") {
      let struct_name: str = curr_struct.name;
      let llvm_struct_name: str = "%" + struct_name;
      let layout: StructLayoutEntry = add_struct_layout(emitter, struct_name, llvm_struct_name);
      
      let fields_str: str = "";
      let field_idx: i32 = 0;
      let curr_f: ASTNode = curr_struct.fields;
      while (curr_f != null) {
        let field_type: str = vks_type_to_llvm(curr_f.returnType);
        add_struct_field(layout, curr_f.name, field_type, field_idx);
        
        if (field_idx > 0) { fields_str = fields_str + ", "; }
        fields_str = fields_str + field_type;
        
        field_idx = field_idx + 1;
        curr_f = curr_f.next;
      }
      
      emit_line(emitter, llvm_struct_name + " = type { " + fields_str + " }");
    }
    curr_struct = curr_struct.next;
  }
  
  // Second pass: define function signatures
  let curr_decl: ASTNode = program.right;
  while (curr_decl != null) {
    if (curr_decl.kind == "FunctionDecl") {
      let ret_type: str = "void";
      if (curr_decl.returnType != null) { ret_type = vks_type_to_llvm(curr_decl.returnType); }
      set_function_return(emitter, curr_decl.name, ret_type);
    }
    curr_decl = curr_decl.next;
  }

  // Third pass: emit functions
  curr_decl = program.right;
  while (curr_decl != null) {
    if (curr_decl.kind == "FunctionDecl") {
      emit_function(emitter, curr_decl);
    }
    curr_decl = curr_decl.next;
  }

  // Collect output
  let out_str: str = "";
  
  // Global strings
  let curr_buf: OutputBuffer = emitter.global_strings;
  while (curr_buf != null) {
    out_str = curr_buf.line + "\n" + out_str; // Prepend to reverse
    curr_buf = curr_buf.next;
  }
  
  // Trampolines
  curr_buf = emitter.trampolines;
  while (curr_buf != null) {
    out_str = curr_buf.line + "\n" + out_str;
    curr_buf = curr_buf.next;
  }

  curr_buf = emitter.out_head;
  while (curr_buf != null) {
    out_str = out_str + curr_buf.line + "\n";
    curr_buf = curr_buf.next;
  }

  return out_str;
}
