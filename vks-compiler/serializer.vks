import "compiler.vks";

function rle_encode(head: Bytecode, count: i32) -> i32[] {
  let arr: i32[] = [];
  if (count == 0) {
    return arr;
  }

  let curr: Bytecode = head;
  let current_line: i32 = curr.line;
  let line_count: i32 = 0;

  while (curr != null) {
    if (curr.line == current_line) {
      line_count = line_count + 1;
    } else {
      array_push(arr, line_count);
      array_push(arr, current_line);
      current_line = curr.line;
      line_count = 1;
    }
    curr = curr.next;
  }

  array_push(arr, line_count);
  array_push(arr, current_line);
  return arr;
}

function reverse_functions(head: CompiledFunction) -> CompiledFunction {
  let prev: CompiledFunction = null;
  let curr: CompiledFunction = head;
  let next: CompiledFunction = null;
  while (curr != null) {
    next = curr.next;
    curr.next = prev;
    prev = curr;
    curr = next;
  }
  return prev;
}

function serialize_compiler(c: Compiler, path: str) {
  let buf: i32[] = [];

  // 1. Magic: "VKB\0"
  array_push(buf, 86); // V
  array_push(buf, 75); // K
  array_push(buf, 66); // B
  array_push(buf, 0);  // \0

  // 2. Version
  array_push_u16(buf, 1);

  // Structs (0 for now)
  array_push_u16(buf, 0);

  // 3. Functions
  array_push_u16(buf, c.functions_count + 1);

  let curr_fn: CompiledFunction = reverse_functions(c.functions_head);
  while (curr_fn != null) {
    array_push_str(buf, curr_fn.name);
    array_push(buf, curr_fn.arity);

    // 3a. Constant Pool
    array_push_u16(buf, curr_fn.chunk.constants_count);
    
    let curr_const: Constant = curr_fn.chunk.constants_head;
    while (curr_const != null) {
      array_push(buf, curr_const.type);
      
      if (curr_const.type == CONST_TYPE_INT) {
        array_push_i32(buf, curr_const.int_val);
      } else if (curr_const.type == CONST_TYPE_FLOAT) {
        array_push_f64(buf, curr_const.float_val);
      } else if (curr_const.type == CONST_TYPE_STRING) {
        array_push_str(buf, curr_const.str_val);
      } else if (curr_const.type == CONST_TYPE_BYTE) {
        array_push(buf, curr_const.int_val);
      } else if (curr_const.type == CONST_TYPE_FUNCTION) {
        array_push_u16(buf, curr_const.fn_index);
      }
      curr_const = curr_const.next;
    }

    // 3b. Bytecode
    array_push_u32(buf, curr_fn.chunk.code_count);
    let curr_byte: Bytecode = curr_fn.chunk.code_head;
    while (curr_byte != null) {
      array_push(buf, curr_byte.val);
      curr_byte = curr_byte.next;
    }

    // 3c. Line Info (RLE encoded)
    let rle_lines: i32[] = rle_encode(curr_fn.chunk.code_head, curr_fn.chunk.code_count);
    let rle_len: i32 = array_length(rle_lines);
    array_push_u32(buf, rle_len);
    let i: i32 = 0;
    while (i < rle_len) {
      array_push_u32(buf, rle_lines[i]);
      i = i + 1;
    }

    curr_fn = curr_fn.next;
  }

  // Write the <script> chunk as the final function
  array_push_str(buf, "<script>");
  array_push(buf, 0); // arity 0

  array_push_u16(buf, c.chunk.constants_count);
  let script_const: Constant = c.chunk.constants_head;
  while (script_const != null) {
    array_push(buf, script_const.type);
    if (script_const.type == CONST_TYPE_INT) { array_push_i32(buf, script_const.int_val); }
    else if (script_const.type == CONST_TYPE_FLOAT) { array_push_f64(buf, script_const.float_val); }
    else if (script_const.type == CONST_TYPE_STRING) { array_push_str(buf, script_const.str_val); }
    else if (script_const.type == CONST_TYPE_BYTE) { array_push(buf, script_const.int_val); }
    else if (script_const.type == CONST_TYPE_FUNCTION) { array_push_u16(buf, script_const.fn_index); }
    script_const = script_const.next;
  }

  array_push_u32(buf, c.chunk.code_count);
  let script_byte: Bytecode = c.chunk.code_head;
  while (script_byte != null) {
    array_push(buf, script_byte.val);
    script_byte = script_byte.next;
  }

  let script_rle: i32[] = rle_encode(c.chunk.code_head, c.chunk.code_count);
  let script_rle_len: i32 = array_length(script_rle);
  array_push_u32(buf, script_rle_len);
  let j: i32 = 0;
  while (j < script_rle_len) {
    array_push_u32(buf, script_rle[j]);
    j = j + 1;
  }

  // 4. Entry Point (the VM expects `<script>`)
  array_push_str(buf, "<script>");

  print("Writing output VKB binary to", path);
  let ok: bool = write_binary(path, buf);
  if (not ok) {
    print("Failed to write binary file", path);
  }
}
