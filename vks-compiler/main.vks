import "lexer.vks";
import "parser.vks";
import "compiler.vks";
import "serializer.vks";
import "pkg.vks";
import "monomorphizer.vks";
import "llvm-emitter.vks";

function compile_file_with_imports(file_path: str, resolved: map<bool>) -> ASTNode {
  if (map_has(resolved, file_path)) {
    let empty_ast: ASTNode = ast_node_new("Program", 0, 0);
    return empty_ast;
  }
  map_set(resolved, file_path, true);
  
  let source: str = read_file(file_path);
  if (source == null or source == "") {
    print("Failed to read file:", file_path);
    return null;
  }
  let tokens: Token = tokenize(source);
  
  let p: Parser = parse(tokens);
  let ast: ASTNode = p.ast;
  
  let merged_decls_head: ASTNode = null;
  let merged_decls_tail: ASTNode = null;
  
  let curr_import: ASTNode = ast.left;
  while (curr_import != null) {
    let imported_path: str = curr_import.str_val;
    if (imported_path == "lexer.vks" or imported_path == "parser.vks" or imported_path == "ast.vks"
        or imported_path == "compiler.vks" or imported_path == "opcodes.vks" or imported_path == "tokens.vks" 
        or imported_path == "serializer.vks" or imported_path == "monomorphizer.vks" or imported_path == "llvm-emitter.vks") {
      imported_path = "vks-compiler/" + imported_path;
    } else {
      imported_path = resolve_import(file_path, imported_path);
    }
      let imported_ast: ASTNode = compile_file_with_imports(imported_path, resolved);
      
      let curr_decl: ASTNode = imported_ast.right;
      while (curr_decl != null) {
        if (merged_decls_head == null) {
          merged_decls_head = curr_decl;
          merged_decls_tail = curr_decl;
        } else {
          merged_decls_tail.next = curr_decl;
          merged_decls_tail = curr_decl;
        }
        curr_decl = curr_decl.next;
      }
    curr_import = curr_import.next;
  }
  
  let curr_decl2: ASTNode = ast.right;
  while (curr_decl2 != null) {
    if (merged_decls_head == null) {
      merged_decls_head = curr_decl2;
      merged_decls_tail = curr_decl2;
    } else {
      merged_decls_tail.next = curr_decl2;
      merged_decls_tail = curr_decl2;
    }
    curr_decl2 = curr_decl2.next;
  }
  
  let merged_ast: ASTNode = ast_node_new("Program", 1, 1);
  merged_ast.right = merged_decls_head;
  return merged_ast;
}

function compile_file(file_path: str) -> Compiler {
  let resolved: map<bool> = map_create();
  let ast: ASTNode = compile_file_with_imports(file_path, resolved);
  let c: Compiler = compile(ast);
  return c;
}

function main() {
  let count: i32 = args_count();
  
  if (count < 1) {
    print("Usage: vks <command> [args...]");
    print("Commands:");
    print("  build <target.vks> [-o output.exe]");
    print("  compile <target.vks> [-o output.vkb]");
    print("  init");
    print("  install");
    return null;
  }
  
  let cmd: str = args_get(0);
  
  if (cmd == "init") {
    init_project(".");
    return null;
  }
  if (cmd == "install") {
    install_all(".");
    return null;
  }
  
  if (cmd == "compile") {
    if (args_count() < 2) {
      print("Usage: vks compile <target.vks> [--llvm|--native] [-o output]");
      return null;
    }
    let target_file: str = args_get(1);
    
    let is_llvm: bool = false;
    let is_native: bool = false;
    let output_file: str = null;
    let target_triple: str = "x86_64-w64-mingw32";
    
    let i: i32 = 2;
    while (i < args_count()) {
      let arg: str = args_get(i);
      if (arg == "--llvm") { is_llvm = true; i = i + 1; }
      else if (arg == "--native") { is_native = true; is_llvm = true; i = i + 1; }
      else if (arg == "-o" and i + 1 < args_count()) {
        output_file = args_get(i + 1);
        i = i + 2;
      } else { i = i + 1; }
    }
    
    if (output_file != null) {
      if (indexOf(output_file, ".ll") > 0) { is_llvm = true; }
      if (indexOf(output_file, ".exe") > 0) { is_llvm = true; is_native = true; }
    }
    
    if (is_llvm) {
      if (output_file == null) {
        if (is_native) { output_file = "output.exe"; }
        else { output_file = target_file + ".ll"; }
      }
      let resolved: map<bool> = map_create();
      let ast: ASTNode = compile_file_with_imports(target_file, resolved);
      let mono_ast: ASTNode = monomorphize(ast);
      let llvm_ir: str = emit_program(mono_ast, target_triple);
      if (is_native) {
        let ll_file: str = target_file + ".ll";
        write_file(ll_file, llvm_ir);
        let compiler_dir: str = get_env("VKS_HOME");
        let runtime_path: str = "runtime.c";
        let runtime_ext_path: str = "vks_runtime_ext.c";
        if (compiler_dir != null) {
          runtime_path = compiler_dir + "/lib/runtime.c";
          runtime_ext_path = compiler_dir + "/lib/vks_runtime_ext.c";
        }
        let clang_cmd: str = "clang " + ll_file + " " + runtime_path + " " + runtime_ext_path + " -o " + output_file + " -lws2_32 -pthread -target " + target_triple;
        system(clang_cmd);
      } else {
        write_file(output_file, llvm_ir);
      }
    } else {
      if (output_file == null) { output_file = "output.vkb"; }
      let c: Compiler = compile_file(target_file);
      serialize_compiler(c, output_file);
    }
    return null;
  }
  
  if (cmd == "build") {
    if (args_count() < 2) {
      print("Usage: vks build <target.vks> [-o output.exe]");
      return null;
    }
    let target_file: str = args_get(1);
    
    // Auto-derive output filename if not provided
    // For now we'll just use output.exe as default
    let output_file: str = "output.exe";
    let target_triple: str = "x86_64-w64-mingw32";
    
    let i: i32 = 2;
    while (i < args_count()) {
      if (args_get(i) == "-o" and i + 1 < args_count()) {
        output_file = args_get(i + 1);
        i = i + 2;
      } else {
        i = i + 1;
      }
    }
    
    let ll_file: str = target_file + ".ll";
    let resolved: map<bool> = map_create();
    let ast: ASTNode = compile_file_with_imports(target_file, resolved);
    let mono_ast: ASTNode = monomorphize(ast);
    let llvm_ir: str = emit_program(mono_ast, target_triple);
    write_file(ll_file, llvm_ir);
    
    // We assume runtime.c and vks_runtime_ext.c are shipped next to the compiler or available in a known path.
    // In the Standalone Installer, we bundle them into the lib/ dir relative to the bin.
    // For now, we will assume they are in the current directory or the compiler's dir.
    // Since VKS doesn't have an easy way to get executable dir yet, we will just use a heuristic
    let compiler_dir: str = get_env("VKS_HOME");
    let runtime_path: str = "runtime.c";
    let runtime_ext_path: str = "vks_runtime_ext.c";
    if (compiler_dir != null) {
      runtime_path = compiler_dir + "/lib/runtime.c";
      runtime_ext_path = compiler_dir + "/lib/vks_runtime_ext.c";
    }
    
    let clang_cmd: str = "clang " + ll_file + " " + runtime_path + " " + runtime_ext_path + " -o " + output_file + " -lws2_32 -pthread -target " + target_triple;
    system(clang_cmd);
    
    return null;
  }
  
  if (cmd == "--llvm-self") {
    if (args_count() < 2) {
      print("Usage: vks --llvm-self <target.vks> [-o output.ll] [--target triple]");
      return null;
    }
    let target_file: str = args_get(1);
    let output_file: str = "output.ll";
    let target_triple: str = "x86_64-w64-mingw32"; // default

    let i: i32 = 2;
    while (i < args_count()) {
      if (args_get(i) == "-o" and i + 1 < args_count()) {
        output_file = args_get(i + 1);
        i = i + 2;
      } else if (args_get(i) == "--target" and i + 1 < args_count()) {
        target_triple = args_get(i + 1);
        i = i + 2;
      } else {
        i = i + 1;
      }
    }
    
    let resolved: map<bool> = map_create();
    let ast: ASTNode = compile_file_with_imports(target_file, resolved);
    let mono_ast: ASTNode = monomorphize(ast);
    let llvm_ir: str = emit_program(mono_ast, target_triple);
    write_file(output_file, llvm_ir);
    return null;
  }
  
  // Backwards compatibility for running just `vks target.vks` without `compile`
  let target_file_old: str = cmd;
  let output_file_old: str = "output.vkb";
  if (args_count() >= 3 and args_get(1) == "-o") {
    output_file_old = args_get(2);
  }
  
  let c2: Compiler = compile_file(target_file_old);
  serialize_compiler(c2, output_file_old);
}

