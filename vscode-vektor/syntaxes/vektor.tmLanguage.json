{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vektor",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.vk",
          "match": "//.*$"
        },
        {
          "name": "comment.block.vk",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.vk",
          "match": "\\b(if|else|while|for|in|return|break|continue|spawn|import)\\b"
        },
        {
          "name": "keyword.declaration.vk",
          "match": "\\b(fn|function|let|const|struct)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.vk",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|float|double|bool|str|char|void|Result|Option|Map)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.vk",
          "match": "\\b(true|false|null|Ok|Err|Some|None)\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.vk",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.vk",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.vk",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.vk",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.vk",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    }
  },
  "scopeName": "source.vk"
}
