{
  "name": "vscode-vektor",
  "displayName": "VektorScript",
  "description": "Official language support and Language Server (LSP) for VektorScript",
  "version": "0.2.0",
  "publisher": "vks-lang",
  "repository": {
    "type": "git",
    "url": "https://github.com/Eren-Jaeger-DEV/VKS.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:vks"
  ],
  "categories": [
    "Programming Languages"
  ],
  "scripts": {
    "vscode:prepublish": "tsc -p ./",
    "compile": "tsc -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "vektor",
        "aliases": [
          "VektorScript",
          "vektor"
        ],
        "extensions": [
          ".vk"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vektor",
        "scopeName": "source.vk",
        "path": "./syntaxes/vks.tmLanguage.json"
      }
    ]
  }
}
