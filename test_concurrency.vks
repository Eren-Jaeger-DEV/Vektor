fn worker(id: i32) {
    let i: i32 = 0;
    while i < 5 {
        print("Worker", id, "counting:", i);
        i++;
    }
}

fn main() {
    print("Spawning workers...");
    let t1: i8* = spawn worker(1);
    let t2: i8* = spawn worker(2);
    
    print("Waiting for workers...");
    thread_join(t1);
    thread_join(t2);
    print("All workers done.");
}
