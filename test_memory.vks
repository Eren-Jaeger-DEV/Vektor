function test_memory(size: i32) -> void {
  // 1. Allocation
  let buffer: ptr<i8> = alloc(size);
  
  // 2. Deref and assignment
  *buffer = 42;
  
  // 3. Pointer arithmetic (not implemented in batch 2, we just use ++ for now if it works, wait, ++ on pointer?)
  // Actually let's test integer ++ and --
  let counter: i32 = 0;
  counter++;
  counter--;
  
  // 4. Address of
  let x: i32 = 100;
  let px: ptr<i32> = &x;
  
  // 5. Free
  free(buffer);
}

function main() {
  test_memory(1024);
}
