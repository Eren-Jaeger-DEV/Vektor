// Full Vektor Example
// Exercises every major language feature from the spec.

import "io.vk";

// A struct representing a player
struct Player {
    name: byte[];
    score: i32;
    alive: bool;
}

// A function that can fail
fn get_rank(score: i32) -> Result<byte[], byte[]> {
    if score < 0 {
        return Err("Score cannot be negative");
    }
    if score >= 90 {
        return Ok("S Rank");
    } else if score >= 75 {
        return Ok("A Rank");
    } else {
        return Ok("B Rank");
    }
}

function main() {
    // Variables and constants
    let age: i32 = 20;
    let pi: f64 = 3.14159;
    let alive: bool = true;
    let initial: byte = 'V';
    const MAX_PLAYERS: i32 = 100;

    // String handling
    let name: str = "Vektor";
    let length: i32 = name.len;
    let raw: byte[] = name.bytes;

    // Nullable types
    let x: i32 = 10;
    let y: i32? = null;

    if y != null {
        print(y);
    }

    // Struct usage
    let p: Player = Player { name: "Vektor", score: 95, alive: true };
    print(p.name);

    // Result handling
    let rank = get_rank(p.score);
    if rank.ok {
        print(rank.value);
    } else {
        print(rank.error);
    }

    // Boolean operators — both styles
    if x > 5 && y != null {}
    if x > 5 and y != null {}
    if !alive {}
    if not alive {}

    // Loops
    let i: i32 = 0;
    while i < 10 {
        print(i);
        i = i + 1;
    }

    for (let j: i32 = 0; j < 10; j++) {
        print(j);
    }

    for k in 0..10 {
        print(k);
    }

    // Arrays
    let scores: i32[5] = [10, 20, 30, 40, 50];
    let first: i32 = scores[0];

    // Pointers and memory
    let val: i32 = 42;
    let ptr_val: ptr<i32> = &val;
    let deref: i32 = *ptr_val;

    let buffer: ptr<byte> = alloc(256);
    buffer[0] = 'V';
    free(buffer);

    // Type casting
    let a: f32 = 3.14;
    let b: i32 = cast<i32>(a);

    // Ownership
    let original: str = "Vektor";
    let copy: str = clone(original);
    print(copy);
}
