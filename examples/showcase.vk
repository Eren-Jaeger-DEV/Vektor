// ============================================================
// Vektor — Language Capability Showcase
// ============================================================
// Demonstrates structs, Result error handling, memory allocation,
// math intrinsics, arrays, and standard library interaction.
// ============================================================

import "math.vk";

struct Task {
    id: i32;
    title: str;
    priority: i32;
    completed: bool;
}

struct Project {
    name: str;
    task_count: i32;
}

fn create_task(id: i32, title: str, priority: i32) -> Result<Task, str> {
    if (priority < 1 || priority > 5) {
        return Err("Priority must be between 1 and 5");
    }
    return Ok(Task {
        id: id,
        title: title,
        priority: priority,
        completed: false
    });
}

function calculate_score(priority: i32, base: f64) -> f64 {
    let factor: f64 = cast<f64>(priority) * 1.5;
    return pow(base, 2.0) + factor;
}

function main() {
    print("==================================================");
    print("        🚀 VEKTOR DEMO & TEST SUITE         ");
    print("==================================================");
    print("");

    // 1. Struct & Result Error Handling Test
    print("[Test 1] Testing Structs & Result<T, E> Error Handling:");
    let res1 = create_task(1, "Build LLVM Native Backend", 5);
    if (res1.ok) {
        let t: Task = res1.value;
        print("  ✓ Created Task #" + toString(t.id) + ": " + t.title + " (Priority: " + toString(t.priority) + ")");
    } else {
        print("  ✗ Error: " + res1.error);
    }

    let res2 = create_task(2, "Invalid Task", 99);
    if (res2.ok) {
        print("  ✓ Created Task #" + toString(res2.value.id));
    } else {
        print("  ✓ Expected Error Caught: " + res2.error);
    }
    print("");

    // 2. Math Library & Type Casting Test
    print("[Test 2] Testing Math Library & Floating Point Calculations:");
    let score1 = calculate_score(5, 4.0);
    let score2 = calculate_score(3, 3.0);
    print("  Calculated Score (Base 4.0, Priority 5): " + toString(score1));
    print("  Calculated Score (Base 3.0, Priority 3): " + toString(score2));
    print("  Max Score: " + toString(max(score1, score2)));
    print("  Min Score: " + toString(min(score1, score2)));
    print("  Clamped (1.0 to 10.0): " + toString(clamp(score1, 1.0, 10.0)));
    print("");

    // 3. Array & Loop Range Iteration Test
    print("[Test 3] Testing Range Loops & Iteration:");
    let sum: i32 = 0;
    for i in 1..6 {
        sum = sum + i;
    }
    print("  Sum of numbers 1..5: " + toString(sum));
    print("");

    // 4. Memory Allocation & Heap Control Test
    print("[Test 4] Testing Manual Memory Allocation (alloc/free):");
    let ptr_buf = alloc(64);
    print("  Heap Buffer Allocated at: " + toString(ptr_buf));
    free(ptr_buf);
    print("  Heap Buffer Successfully Freed.");
    print("");

    print("==================================================");
    print("  🎉 ALL VEKTOR TESTS PASSED SUCCESSFULLY!  ");
    print("==================================================");
}
