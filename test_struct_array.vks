struct Point {
  x: i32;
  y: i32;
}

function test_structs() {
  let p: Point = Point { x: 10, y: 20 };
  let x_val: i32 = p.x;
  let y_val: i32 = p.y;
  p.x = 100;
  
  let expected: i32 = p.x + y_val;
}

function test_arrays() {
  let arr: array<i32> = [1, 2, 3, 4, 5];
  let first: i32 = arr[0];
  let last: i32 = arr[4];
  
  arr[2] = 100;
}

function main() {
  test_structs();
  test_arrays();
}
