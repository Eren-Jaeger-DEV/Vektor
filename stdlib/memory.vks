// stdlib/memory.vks — Memory helpers
// Low-level alloc/free are language keywords; these are convenience wrappers.

const STDLIB_MEMORY_VERSION: i32 = 1;

fn alloc_bytes(size: i32) -> ptr<byte> {
  return alloc(size);
}

fn alloc_i32() -> ptr<i32> {
  return alloc(4);
}

fn alloc_zeroed(size: i32) -> ptr<byte> {
  let buf: ptr<byte> = alloc(size);
  let i: i32 = 0;
  while i < size {
    buf[i] = 0;
    i = i + 1;
  }
  return buf;
}
